---
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<section class="hero" id="home">
	<!-- Video Container -->
	<div class="video-wrapper">
		<video autoplay loop muted playsinline preload="auto" class="hero-video">
			<source src={`${base}hero-video.mp4`} type="video/mp4" />
		</video>
		<div class="hero-overlay"></div>
	</div>

	<!-- SEO Accessible Heading -->
	<h1 class="sr-only">Duke City Fencing Club - Strike First | Olympic Fencing Albuquerque NM</h1>

	<!-- Hero Content & CTAs -->
	<div class="hero-content">
		<div class="trust-badge">
			<i class="fas fa-star gold-star"></i> Olympic-Level Training
		</div>
		<p class="hero-desc">
			Elite competitive and recreational fencing in Albuquerque, NM. Led by 3-time Olympian and World Medalist, Courtney Hurley.
		</p>
		<div class="hero-cta-group">
			<button class="btn-cta-hero open-booking" type="button">Book Your Class</button>
			<a href={`${base}#programs`} class="btn-outline-hero">Explore Programs</a>
		</div>
	</div>
</section>

<style>
	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border-width: 0;
	}

	.hero {
		position: relative;
		text-align: center;
		border-bottom: 5px solid var(--accent-red);
		overflow: hidden;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		min-height: 88vh;
		background-color: var(--primary-green);
	}

	.video-wrapper {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		overflow: hidden;
		z-index: 0;
		background-color: #040e0a;
	}

	.hero-video {
		position: absolute;
		top: 50%;
		left: 50%;
		min-width: 100%;
		min-height: 100%;
		width: auto;
		height: auto;
		transform: translateX(-50%) translateY(-50%);
		object-fit: cover;
	}

	.hero-overlay {
		display: none;
	}

	.hero-content {
		position: relative;
		z-index: 2;
		color: var(--text-light);
		padding: 3rem 1.5rem;
		max-width: 800px;
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	.trust-badge {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		background: rgba(0, 59, 43, 0.7);
		backdrop-filter: blur(10px);
		padding: 0.5rem 1.25rem;
		border-radius: 50px;
		font-size: 0.85rem;
		font-weight: 700;
		margin-bottom: 1.5rem;
		border: 1px solid rgba(255, 255, 255, 0.25);
		text-transform: uppercase;
		letter-spacing: 1.5px;
		box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
	}

	.gold-star {
		color: var(--gold);
	}

	.hero-desc {
		font-size: 1.25rem;
		margin-bottom: 2.25rem;
		max-width: 680px;
		margin-inline: auto;
		opacity: 0.98;
		line-height: 1.6;
		text-shadow: 0 2px 12px rgba(0, 0, 0, 0.85);
		font-weight: 500;
	}

	.hero-cta-group {
		display: flex;
		gap: 1.25rem;
		justify-content: center;
		align-items: center;
		flex-wrap: wrap;
	}

	.btn-cta-hero {
		background-color: var(--accent-red);
		color: var(--text-light);
		padding: 0.95rem 2.2rem;
		border-radius: var(--border-radius);
		font-weight: 800;
		font-family: var(--font-headings);
		text-transform: uppercase;
		font-size: 0.95rem;
		border: none;
		cursor: pointer;
		transition: background 0.3s, transform 0.2s, box-shadow 0.3s;
		letter-spacing: 1.5px;
		box-shadow: 0 6px 20px rgba(226, 10, 23, 0.45);
	}

	.btn-cta-hero:hover {
		background-color: var(--accent-red-hover);
		transform: translateY(-3px);
		box-shadow: 0 10px 25px rgba(226, 10, 23, 0.6);
	}

	.btn-outline-hero {
		background: rgba(0, 59, 43, 0.5);
		backdrop-filter: blur(8px);
		color: var(--text-light);
		padding: 0.9rem 2rem;
		border-radius: var(--border-radius);
		font-weight: 700;
		font-family: var(--font-headings);
		text-transform: uppercase;
		font-size: 0.9rem;
		border: 2px solid rgba(255, 255, 255, 0.85);
		cursor: pointer;
		transition: background 0.3s, border-color 0.3s, transform 0.2s;
		letter-spacing: 1px;
	}

	.btn-outline-hero:hover {
		background: rgba(255, 255, 255, 0.2);
		border-color: #fff;
		transform: translateY(-3px);
	}

	/* ========================================================
	   MOBILE VIEW: 100% Complete Uncropped Video + Seamless Gradient
	   ======================================================== */
	@media (max-width: 768px) {
		.hero {
			min-height: auto;
			padding: 0 0 3rem 0;
			justify-content: flex-start;
			background-color: var(--primary-green);
		}

		.video-wrapper {
			position: relative;
			width: 100%;
			height: auto;
			aspect-ratio: 16 / 9;
			display: block;
			background-color: #000;
		}

		.hero-video {
			position: absolute;
			top: 0;
			left: 0;
			transform: none;
			width: 100%;
			height: 100%;
			min-width: 100%;
			min-height: 100%;
			object-fit: contain;
			background-color: #000;
		}

		.hero-overlay {
			display: block;
			position: absolute;
			inset: 0;
			background: linear-gradient(to bottom, transparent 65%, var(--primary-green) 100%);
			pointer-events: none;
			z-index: 1;
		}

		.hero-content {
			position: relative;
			z-index: 2;
			padding: 0 1.25rem;
			width: 100%;
			max-width: 480px;
			margin-top: -1.25rem;
		}

		.trust-badge {
			font-size: 0.78rem;
			padding: 0.45rem 1.1rem;
			margin-bottom: 1.25rem;
			background: rgba(0, 30, 20, 0.85);
			backdrop-filter: blur(12px);
			border: 1px solid rgba(255, 255, 255, 0.3);
			box-shadow: 0 6px 20px rgba(0, 0, 0, 0.4);
		}

		.hero-desc {
			font-size: 1.05rem;
			line-height: 1.6;
			margin-bottom: 1.75rem;
			text-shadow: 0 2px 8px rgba(0, 0, 0, 0.5);
			opacity: 0.95;
			font-weight: 500;
			color: var(--bg-cream);
		}

		.hero-cta-group {
			flex-direction: column;
			width: 100%;
			max-width: 320px;
			margin: 0 auto;
			gap: 0.85rem;
		}

		.btn-cta-hero, .btn-outline-hero {
			width: 100%;
			text-align: center;
			padding: 0.95rem 1.5rem;
			font-size: 0.92rem;
		}

		.btn-outline-hero {
			background: rgba(255, 255, 255, 0.08);
			backdrop-filter: blur(10px);
			border: 1.5px solid rgba(255, 255, 255, 0.75);
			color: var(--text-light);
		}

		.btn-outline-hero:hover {
			background: rgba(255, 255, 255, 0.2);
			border-color: #fff;
		}
	}
</style>

