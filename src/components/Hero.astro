---
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<section class="hero" id="home">
	<video autoplay loop muted playsinline class="hero-video" poster={`${base}foto-competitivo-1.jpg`}>
		<source src={`${base}hero-video.mp4`} type="video/mp4" />
	</video>
	<div class="hero-overlay"></div>
	<div class="hero-content">
		<div class="trust-badge">
			<i class="fas fa-star gold-star"></i> Olympic-Level Training
		</div>
		<h1>STRIKE FIRST</h1>
		<p>
			Elite competitive and recreational fencing in Albuquerque, NM. Led by 3-time Olympian and World Medalist, Courtney Hurley.
		</p>
		<div class="hero-cta-group">
			<button class="btn-cta-hero open-booking" type="button">Book Your Class</button>
			<a href={`${base}#programs`} class="btn-outline-hero">Explore Programs</a>
		</div>
	</div>
</section>

<style>
	.hero {
		position: relative;
		text-align: center;
		border-bottom: 5px solid var(--accent-red);
		overflow: hidden;
		display: flex;
		align-items: center;
		justify-content: center;
		min-height: 92vh;
	}

	.hero-video {
		position: absolute;
		top: 50%;
		left: 50%;
		min-width: 100%;
		min-height: 100%;
		width: auto;
		height: auto;
		transform: translateX(-50%) translateY(-50%);
		z-index: 0;
		object-fit: cover;
	}

	.hero-overlay {
		display: none;
	}

	.hero-content {
		position: relative;
		z-index: 2;
		color: var(--text-light);
		padding: 3rem 1.5rem;
		max-width: 900px;
		margin: 0 auto;
	}

	.trust-badge {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		background: rgba(255, 255, 255, 0.12);
		backdrop-filter: blur(8px);
		padding: 0.5rem 1.25rem;
		border-radius: 50px;
		font-size: 0.85rem;
		font-weight: 700;
		margin-bottom: 2rem;
		border: 1px solid rgba(255, 255, 255, 0.25);
		text-transform: uppercase;
		letter-spacing: 1.5px;
	}

	.gold-star {
		color: var(--gold);
	}

	.hero h1 {
		font-size: 4.5rem;
		margin-bottom: 1.25rem;
		line-height: 1.05;
		letter-spacing: 3px;
		text-shadow: 0 4px 20px rgba(0, 0, 0, 0.7);
	}

	.hero p {
		font-size: 1.25rem;
		margin-bottom: 2.5rem;
		max-width: 720px;
		margin-inline: auto;
		opacity: 0.95;
		line-height: 1.7;
		text-shadow: 0 2px 10px rgba(0, 0, 0, 0.6);
	}

	.hero-cta-group {
		display: flex;
		gap: 1.25rem;
		justify-content: center;
		align-items: center;
		flex-wrap: wrap;
	}

	.btn-cta-hero {
		background-color: var(--accent-red);
		color: var(--text-light);
		padding: 1rem 2.25rem;
		border-radius: var(--border-radius);
		font-weight: 800;
		font-family: var(--font-headings);
		text-transform: uppercase;
		font-size: 1rem;
		border: none;
		cursor: pointer;
		transition: background 0.3s, transform 0.2s, box-shadow 0.3s;
		letter-spacing: 1.5px;
		box-shadow: 0 6px 20px rgba(226, 10, 23, 0.4);
	}

	.btn-cta-hero:hover {
		background-color: var(--accent-red-hover);
		transform: translateY(-3px);
		box-shadow: 0 10px 25px rgba(226, 10, 23, 0.6);
	}

	.btn-outline-hero {
		background: transparent;
		color: var(--text-light);
		padding: 0.95rem 2rem;
		border-radius: var(--border-radius);
		font-weight: 700;
		font-family: var(--font-headings);
		text-transform: uppercase;
		font-size: 0.95rem;
		border: 2px solid rgba(255, 255, 255, 0.8);
		cursor: pointer;
		transition: background 0.3s, border-color 0.3s, transform 0.2s;
		letter-spacing: 1px;
	}

	.btn-outline-hero:hover {
		background: rgba(255, 255, 255, 0.15);
		border-color: #fff;
		transform: translateY(-3px);
	}

	@media (max-width: 768px) {
		.hero {
			min-height: 85vh;
		}
		.hero h1 {
			font-size: 2.8rem;
		}
		.hero p {
			font-size: 1.05rem;
		}
		.hero-cta-group {
			flex-direction: column;
			width: 100%;
		}
		.btn-cta-hero, .btn-outline-hero {
			width: 100%;
			text-align: center;
		}
	}
</style>
