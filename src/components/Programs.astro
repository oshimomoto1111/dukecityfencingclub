<script>
	// Tab Filter Functionality
	const tabs = document.querySelectorAll('.tab-btn');
	const cards = document.querySelectorAll('.program-card-v2');

	tabs.forEach((tab) => {
		tab.addEventListener('click', () => {
			tabs.forEach((t) => {
				t.classList.remove('active');
				t.setAttribute('aria-selected', 'false');
			});
			tab.classList.add('active');
			tab.setAttribute('aria-selected', 'true');

			const filter = tab.getAttribute('data-filter');

			cards.forEach((card) => {
				const cardCat = card.getAttribute('data-category');
				if (filter === 'all' || cardCat === filter) {
					(card as HTMLElement).style.display = 'flex';
				} else {
					(card as HTMLElement).style.display = 'none';
				}
			});
		});
	});

	// Interactive Card Expand / Collapse Logic
	cards.forEach((card) => {
		const trigger = card.querySelector('.card-cover-trigger');
		const closeBtn = card.querySelector('.btn-close-card');
		const promptText = card.querySelector('.prompt-text');

		const toggleCard = () => {
			const isExpanded = card.classList.contains('expanded');

			if (isExpanded) {
				card.classList.remove('expanded');
				trigger?.setAttribute('aria-expanded', 'false');
				if (promptText) promptText.textContent = 'View Pricing & Details';
			} else {
				card.classList.add('expanded');
				trigger?.setAttribute('aria-expanded', 'true');
				if (promptText) promptText.textContent = 'Hide Details';
			}
		};

		trigger?.addEventListener('click', toggleCard);

		trigger?.addEventListener('keydown', (e) => {
			const keyEvent = e as KeyboardEvent;
			if (keyEvent.key === 'Enter' || keyEvent.key === ' ') {
				keyEvent.preventDefault();
				toggleCard();
			}
		});

		closeBtn?.addEventListener('click', (e) => {
			e.stopPropagation();
			card.classList.remove('expanded');
			trigger?.setAttribute('aria-expanded', 'false');
			if (promptText) promptText.textContent = 'View Pricing & Details';
			// Smoothly scroll back to the top of this card if needed
			card.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
		});
	});
</script>
