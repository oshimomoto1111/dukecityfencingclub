---
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;

const programs = [
	{
		title: "Youth & Beginners",
		description: "The perfect starting point. Focused on fundamentals, coordination, safety, and fun for new fencers of all ages.",
		imgDefault: `${base}foto-jovenes-1.jpg`,
		imgHover: `${base}foto-jovenes-2.jpg`,
	},
	{
		title: "Competitive Epee",
		description: "For serious athletes. Advanced tactics, precision footwork, strip strategy, and preparation for national and international tournaments.",
		imgDefault: `${base}foto-competitivo-1.jpg`,
		imgHover: `${base}foto-competitivo-2.jpg`,
	},
	{
		title: "Adult Fencing",
		description: "Recreational and conditioning classes designed for adults. Great cardio, mental sharpness, and a welcoming community.",
		imgDefault: `${base}foto-adultos-1.jpg`,
		imgHover: `${base}foto-adultos-2.jpg`,
	},
];
---

<section class="programs" id="programs">
	<h2 class="section-title">Our Programs</h2>
	<div class="grid-container">
		{programs.map((program) => (
			<div class="program-card">
				<div class="bg-default" style={`background-image: url('${program.imgDefault}');`}></div>
				<div class="bg-hover" style={`background-image: url('${program.imgHover}');`}></div>
				<div class="card-content">
					<h3>{program.title}</h3>
					<div class="card-details">
						<p>{program.description}</p>
						<button class="btn-card open-booking" type="button">Book A Class</button>
					</div>
				</div>
			</div>
		))}
	</div>
</section>

<style>
	.programs {
		padding: var(--section-padding);
		max-width: 1240px;
		margin: 0 auto;
	}

	.grid-container {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
		gap: 2.5rem;
	}

	.program-card {
		position: relative;
		height: 440px;
		border-radius: var(--border-radius);
		overflow: hidden;
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		box-shadow: 0 10px 25px rgba(0, 0, 0, 0.12);
		cursor: pointer;
		border: 1px solid rgba(0, 59, 43, 0.08);
	}

	.bg-default, .bg-hover {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background-size: cover;
		background-position: center;
		transition: opacity 0.6s cubic-bezier(0.25, 0.8, 0.25, 1), transform 0.6s cubic-bezier(0.25, 0.8, 0.25, 1);
	}

	.bg-hover {
		opacity: 0;
		transform: scale(1.06);
	}

	.program-card:hover .bg-default {
		opacity: 0;
	}

	.program-card:hover .bg-hover {
		opacity: 1;
		transform: scale(1);
	}

	.program-card::after {
		content: '';
		position: absolute;
		inset: 0;
		background: linear-gradient(to top, rgba(0, 59, 43, 0.95) 0%, rgba(0, 59, 43, 0.35) 60%, transparent 100%);
		z-index: 1;
		transition: background 0.6s ease;
	}

	.program-card:hover::after {
		background: linear-gradient(to top, rgba(0, 59, 43, 0.98) 0%, rgba(0, 59, 43, 0.85) 100%);
	}

	.card-content {
		position: relative;
		z-index: 2;
		padding: 2rem;
		color: var(--text-light);
		text-align: center;
		transform: translateY(115px);
		transition: transform 0.6s cubic-bezier(0.25, 0.8, 0.25, 1);
	}

	.program-card:hover .card-content {
		transform: translateY(0);
	}

	.card-content h3 {
		font-size: 1.65rem;
		margin-bottom: 1rem;
		color: var(--bg-cream);
		text-shadow: 0 2px 4px rgba(0, 0, 0, 0.5);
	}

	.card-details {
		opacity: 0;
		transition: opacity 0.5s ease;
	}

	.program-card:hover .card-details {
		opacity: 1;
		transition-delay: 0.15s;
	}

	.card-details p {
		font-size: 0.95rem;
		margin-bottom: 1.5rem;
		line-height: 1.6;
		color: var(--bg-cream);
		opacity: 0.95;
	}

	.btn-card {
		display: inline-block;
		background-color: var(--accent-red);
		color: var(--text-light);
		padding: 0.65rem 1.4rem;
		border-radius: var(--border-radius);
		font-weight: 700;
		font-family: var(--font-headings);
		text-transform: uppercase;
		font-size: 0.85rem;
		transition: background 0.3s, transform 0.2s;
		border: none;
		cursor: pointer;
		letter-spacing: 0.5px;
	}

	.btn-card:hover {
		background-color: var(--accent-red-hover);
		transform: translateY(-2px);
	}

	@media (hover: none) {
		.card-content {
			transform: translateY(0);
		}
		.card-details {
			opacity: 1;
		}
	}
</style>
