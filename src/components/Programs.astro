---
// Programs Component with Interactive Category Tabs, Transparent Pricing, and Menaul School Spotlight
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;

const programs = [
	{
		id: "youth",
		category: "youth",
		badge: "Ages 6 – 9",
		level: "Beginners & Mini Musketeers",
		title: "Youth Fencing Class",
		price: "$160",
		period: "/month + tax",
		trialInfo: "★ $10 Trial Class: Saturdays 9:45 AM – 10:30 AM",
		trialBadge: "$10 Trial Available",
		description: "The ideal starting point for young fencers. Engaging, high-energy classes focusing on agility, hand-eye coordination, blade safety, and fun fundamentals.",
		schedules: [
			{ days: "Mon & Wed", time: "4:30 PM – 6:00 PM" },
			{ days: "Sat (Tournament)", time: "11:00 AM – 2:00 PM" },
		],
		features: [
			"Full protective fencing gear provided for new students",
			"Fundamental footwork, distance drills, and safety etiquette",
			"Inclusive Saturday morning in-house practice tournaments",
			"Coached by certified youth fencing instructors",
		],
		ctaText: "Book $10 Trial Class",
		ctaLink: "https://duke-city-fencing-club.gymdesk.com/book",
		img: `${base}program-youth.jpg`,
	},
	{
		id: "competitive",
		category: "competitive",
		badge: "Ages 10+",
		level: "Intermediate & Advanced",
		title: "Competitive Epee Program",
		price: "$230",
		period: "/month + tax",
		trialInfo: "★ $10 Trial Session: Saturdays 12:30 PM – 1:15 PM",
		trialBadge: "$10 Trial Available",
		description: "Designed for ambitious athletes dedicated to regional (ROC/RYC) and national (NAC) tournament competition. Comprehensive tactical preparation and footwork.",
		schedules: [
			{ days: "Tue & Thu", time: "5:00 PM – 7:30 PM" },
			{ days: "Mon – Thu", time: "Open Bouting (Included)" },
			{ days: "Sat", time: "Conditioning & Tournament (10:30 AM – 1:00 PM)" },
		],
		features: [
			"Unlimited Open Bouting included at no extra cost",
			"High-intensity physical conditioning & bout analysis",
			"Tournament coaching support & national ranking pathways",
			"Directed by 3-Time Olympic Medalist Courtney Hurley",
		],
		ctaText: "Book Competitive Trial",
		ctaLink: "https://duke-city-fencing-club.gymdesk.com/book",
		img: `${base}program-competitive.jpg`,
		featured: true,
	},
	{
		id: "adults",
		category: "adults",
		badge: "Ages 16+",
		level: "All Skill Levels",
		title: "Adult Recreation Class",
		price: "$140",
		period: "/month + tax",
		trialInfo: "★ $25 Trial & First Class: Mondays 6:30 PM",
		trialBadge: "$25 Trial & Class",
		description: "A premier cardiovascular workout, mental chess on the strip, and a welcoming adult community. Led by Coach Andy with a focus on recreation and Epee skills.",
		schedules: [
			{ days: "Mondays", time: "7:00 PM – 8:00 PM" },
			{ days: "Sat (Tournament)", time: "11:00 AM – 2:00 PM" },
		],
		features: [
			"Zero prior fencing experience required — gear provided",
			"Full-body conditioning, agility, and tactical development",
			"Friendly, collaborative, and social adult atmosphere",
			"Access to Saturday club tournament bouts",
		],
		ctaText: "Book $25 Adult Trial",
		ctaLink: "https://duke-city-fencing-club.gymdesk.com/book",
		img: `${base}program-adults.jpg`,
	},
	{
		id: "bouting",
		category: "training",
		badge: "Members & Visitors",
		level: "Open Sparring",
		title: "Open Bouting & Cross-Training",
		price: "$140",
		period: "/mo (or $20/day pass)",
		trialInfo: "★ $35/mo as an add-on for Youth & Adult members",
		trialBadge: "$20 Drop-In Available",
		description: "Open floor sparring on full electric scoring strips. Test your tactics against diverse opponents and join Friday cross-training conditioning sessions.",
		schedules: [
			{ days: "Mon & Wed", time: "6:00 PM – 7:30 PM" },
			{ days: "Tue & Thu", time: "6:30 PM – 7:30 PM" },
			{ days: "Fridays", time: "Cross-Training / Conditioning" },
		],
		features: [
			"Full electric scoring reels and grounded strips",
			"Free for Competitive Program members",
			"Drop-in visitors and traveling fencers welcome ($20/day)",
			"Friday sport-specific athletic conditioning",
		],
		ctaText: "Get Day Pass / Register",
		ctaLink: "https://duke-city-fencing-club.gymdesk.com/book",
		img: `${base}program-bouting.jpg`,
	},
	{
		id: "private",
		category: "training",
		badge: "Ages 6+",
		level: "Individual 1-on-1",
		title: "Private Coaching Lessons",
		price: "$45",
		period: "/lesson (4-Pack: $165)",
		trialInfo: "★ Book directly on member portal",
		trialBadge: "1-on-1 Coaching",
		description: "One-on-one tailored instruction to rapidly accelerate technical mastery, blade work, point control, and customized competition strategies.",
		schedules: [
			{ days: "Mon – Sat", time: "By Appointment During Open Hours" },
		],
		features: [
			"Dedicated 1-on-1 focus with senior coaching staff",
			"Video review, technical correction, and tactile drills",
			"Save with discounted 4-lesson bundle ($165 + tax)",
			"Easy scheduling through the GymDesk member portal",
		],
		ctaText: "Schedule Private Lesson",
		ctaLink: "https://duke-city-fencing-club.gymdesk.com/book",
		img: `${base}program-private.jpg`,
	},
	{
		id: "tournaments",
		category: "training",
		badge: "All Ages",
		level: "Club Competition",
		title: "Saturday Club Tournaments",
		price: "Included",
		period: "for club members",
		trialInfo: "★ $20 for non-members / visitors",
		trialBadge: "Every Non-Travel Saturday",
		description: "Weekend competitive bouts grouped by age and skill. Experience authentic tournament bouting with real referees in a supportive club setting.",
		schedules: [
			{ days: "Saturdays", time: "11:00 AM – 1:00 PM / 2:00 PM" },
		],
		features: [
			"Poule and Direct Elimination tournament formats",
			"USA Fencing membership required (club membership optional)",
			"Structured preparation for regional and national events",
			"Held whenever the team is not traveling to national tournaments",
		],
		ctaText: "Register for Saturday Bouts",
		ctaLink: "https://duke-city-fencing-club.gymdesk.com/book",
		img: `${base}program-tournaments.jpg`,
	},
];
---

<section class="programs-section" id="programs">
	<div class="programs-container">
		
		<!-- Section Header -->
		<div class="section-header">
			<span class="section-kicker">World-Class Instruction</span>
			<h2 class="section-title-custom">Training Programs & Pricing</h2>
			<p class="section-subtitle">
				From your very first trial class to national podium finishes. Transparent pricing, flexible schedules, and Olympic-caliber coaching for every age and skill level.
			</p>
		</div>

		<!-- Interactive Category Filter Tabs -->
		<div class="filter-tabs" role="tablist" aria-label="Program Categories">
			<button class="tab-btn active" data-filter="all" role="tab" aria-selected="true">All Programs</button>
			<button class="tab-btn" data-filter="youth" role="tab" aria-selected="false">Youth (Ages 6–9)</button>
			<button class="tab-btn" data-filter="competitive" role="tab" aria-selected="false">Competitive (Ages 10+)</button>
			<button class="tab-btn" data-filter="adults" role="tab" aria-selected="false">Adults (Ages 16+)</button>
			<button class="tab-btn" data-filter="training" role="tab" aria-selected="false">Open Bouting & Lessons</button>
		</div>

		<!-- Programs Grid -->
		<div class="programs-grid" id="programsGrid">
			{programs.map((prog) => (
				<article class={`program-card-v2 ${prog.featured ? 'featured-card' : ''}`} data-category={prog.category}>
					{prog.featured && <div class="featured-ribbon">Most Popular</div>}
					
					<!-- Interactive Card Cover / Header (Always Visible) -->
					<div class="card-cover-trigger" role="button" tabindex="0" aria-expanded="false">
						<div class="card-image-wrap" style={`background-image: url('${prog.img}');`}>
							<div class="card-image-overlay"></div>
							
							<div class="card-top-badges">
								<span class="badge-age">{prog.badge}</span>
								<span class="badge-level-chip">{prog.level}</span>
							</div>

							<div class="card-header-content">
								<h3 class="card-title">{prog.title}</h3>
								<div class="card-expand-prompt">
									<span class="prompt-text">View Pricing & Details</span>
									<span class="prompt-icon-bubble"><i class="fas fa-chevron-down"></i></span>
								</div>
							</div>
						</div>
					</div>

					<!-- Expandable Card Body (Hidden by default, unfolds on click) -->
					<div class="card-body-collapsible">
						<div class="card-body-inner">
							<!-- Price Box -->
							<div class="price-box">
								<div class="price-main">
									<span class="price-currency">{prog.price}</span>
									<span class="price-period">{prog.period}</span>
								</div>
								<div class="trial-callout">
									<i class="fas fa-tag"></i> {prog.trialInfo}
								</div>
							</div>

							<p class="card-description">{prog.description}</p>

							<!-- Schedules Block -->
							<div class="schedule-block">
								<div class="schedule-title"><i class="far fa-clock"></i> Class Schedule:</div>
								<div class="schedule-chips">
									{prog.schedules.map((sch) => (
										<div class="schedule-chip">
											<strong>{sch.days}:</strong> {sch.time}
										</div>
									))}
								</div>
							</div>

							<!-- Features List -->
							<ul class="features-list">
								{prog.features.map((feat) => (
									<li>
										<i class="fas fa-check-circle"></i>
										<span>{feat}</span>
									</li>
								))}
							</ul>

							<!-- CTA Button -->
							<div class="card-cta-wrap">
								<button class="btn-program-cta open-booking" type="button">
									{prog.ctaText} <i class="fas fa-arrow-right"></i>
								</button>
								<button class="btn-close-card" type="button">
									<i class="fas fa-chevron-up"></i> Collapse Details
								</button>
							</div>
						</div>
					</div>
				</article>
			))}
		</div>

		<!-- ========================================================
		     SPECIAL SPOTLIGHT: MENAUL SCHOOL PARTNERSHIP
		     ======================================================== -->
		<div class="menaul-spotlight" id="menaul">
			<div class="menaul-spotlight-inner">
				<div class="menaul-header">
					<div class="menaul-badge">
						<i class="fas fa-graduation-cap"></i> Fencing – Find Your Edge • Grades 6–12
					</div>
					<h3>Menaul School Panther Fencing Academy</h3>
					<p class="menaul-lead">
						A ground-breaking athletic and academic partnership offering the <strong>first high school residential & day-school fencing program in the United States</strong>. Students train 5 days a week directly under Program Director <strong>Courtney Hurley</strong> — <em>3x Olympian, London 2012 Bronze Medalist, 2x NCAA Champion (Notre Dame), and certified Fencing Master</em>.
					</p>
				</div>

				<!-- 4 Pillar Cards -->
				<div class="menaul-pillars-grid">
					<div class="pillar-card">
						<div class="pillar-icon"><i class="fas fa-trophy"></i></div>
						<h4>NCAA Division I & Ivy League Pathway</h4>
						<p>
							Strategic tournament coaching and collegiate networking for recruitment into Division I fencing powerhouses (Notre Dame, Stanford, Penn State, Ohio State) and Ivy League admissions (Harvard, Princeton, Columbia, Yale).
						</p>
					</div>

					<div class="pillar-card">
						<div class="pillar-icon"><i class="fas fa-calendar-check"></i></div>
						<h4>Tailored Flexible Academic Schedule</h4>
						<p>
							Menaul School provides a rigorous college-preparatory curriculum structured around intensive daily training and national travel for ROC/NAC competitions without compromising academic excellence.
						</p>
					</div>

					<div class="pillar-card">
						<div class="pillar-icon"><i class="fas fa-mountain"></i></div>
						<h4>High-Altitude Training Advantage</h4>
						<p>
							Albuquerque’s mile-high elevation (5,312 ft) provides a natural cardiovascular endurance boost, giving our fencers a distinct physical edge on the national and world championship strip.
						</p>
					</div>

					<div class="pillar-card">
						<div class="pillar-icon"><i class="fas fa-award"></i></div>
						<h4>Tuition-Free NM Public Universities</h4>
						<p>
							Menaul School graduates qualify for the <em>New Mexico Lottery Scholarship</em>, granting tuition-free access to top state universities like the University of New Mexico (UNM) — applicable even for out-of-state families!
						</p>
					</div>
				</div>

				<!-- Menaul Options & CTA -->
				<div class="menaul-footer-bar">
					<div class="menaul-format-info">
						<span><i class="fas fa-building"></i> <strong>Boarding & Residential:</strong> Full campus dormitories</span>
						<span><i class="fas fa-sun"></i> <strong>Day-School:</strong> Open to local NM students</span>
						<span><i class="fas fa-envelope"></i> <strong>Director:</strong> <a href="mailto:CHurley@menaulschool.org" style="color: var(--gold); text-decoration: underline;">CHurley@menaulschool.org</a></span>
					</div>
					<div class="menaul-actions-group">
						<a href="https://www.menaulschool.org/wp-content/uploads/sites/51/2025/11/Fencingv3-final.pdf" target="_blank" rel="noopener noreferrer" class="btn-menaul-secondary">
							<i class="fas fa-file-pdf"></i> Download Brochure
						</a>
						<a href="https://www.menaulschool.org/admission/apply/" target="_blank" rel="noopener noreferrer" class="btn-menaul-cta">
							Apply to Menaul School <i class="fas fa-external-link-alt"></i>
						</a>
					</div>
				</div>
			</div>
		</div>

		<!-- ========================================================
		     DISCOUNTS & COMMUNITY SAVINGS BANNER
		     ======================================================== -->
		<div class="discounts-banner">
			<div class="discounts-header">
				<i class="fas fa-tags discount-icon"></i>
				<div>
					<h4>Community & Family Discounts</h4>
					<p>We are proud to make the sport of fencing accessible and rewarding for Albuquerque families and service members.</p>
				</div>
			</div>
			<div class="discounts-grid">
				<div class="discount-item">
					<div class="discount-percent">25% OFF</div>
					<div class="discount-label">
						<strong>Sibling & Family Discount</strong>
						<span>Applied to the 2nd and subsequent enrolled family members</span>
					</div>
				</div>
				<div class="discount-item">
					<div class="discount-percent">10% OFF</div>
					<div class="discount-label">
						<strong>Active Military & Veterans</strong>
						<span>Honoring our service members and their immediate families</span>
					</div>
				</div>
				<div class="discount-item">
					<div class="discount-percent">10% OFF</div>
					<div class="discount-label">
						<strong>College Students</strong>
						<span>Valid with current university or college student ID</span>
					</div>
				</div>
			</div>
		</div>

	</div>
</section>

<style>
	.programs-section {
		padding: var(--section-padding);
		background-color: var(--bg-cream);
	}

	.programs-container {
		max-width: 1280px;
		margin: 0 auto;
	}

	/* Section Header */
	.section-header {
		text-align: center;
		max-width: 800px;
		margin: 0 auto 3.5rem;
	}

	.section-kicker {
		display: inline-block;
		color: var(--accent-red);
		font-weight: 800;
		font-size: 0.85rem;
		text-transform: uppercase;
		letter-spacing: 2px;
		margin-bottom: 0.5rem;
	}

	.section-title-custom {
		font-size: 2.75rem;
		color: var(--primary-green);
		margin-bottom: 1rem;
		line-height: 1.15;
	}

	.section-subtitle {
		font-size: 1.1rem;
		color: var(--text-dark);
		opacity: 0.88;
		line-height: 1.6;
	}

	/* Category Filter Tabs */
	.filter-tabs {
		display: flex;
		justify-content: center;
		gap: 0.75rem;
		flex-wrap: wrap;
		margin-bottom: 3.5rem;
	}

	.tab-btn {
		background-color: #fff;
		color: var(--text-dark);
		border: 2px solid rgba(0, 59, 43, 0.15);
		padding: 0.65rem 1.4rem;
		border-radius: 50px;
		font-family: var(--font-headings);
		font-weight: 700;
		font-size: 0.88rem;
		cursor: pointer;
		transition: all 0.25s ease;
		box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
	}

	.tab-btn:hover {
		border-color: var(--primary-green);
		color: var(--primary-green);
		transform: translateY(-2px);
	}

	.tab-btn.active {
		background-color: var(--primary-green);
		color: #fff;
		border-color: var(--primary-green);
		box-shadow: 0 6px 15px rgba(0, 59, 43, 0.25);
	}

	/* Programs Grid */
	.programs-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
		gap: 2rem;
		margin-bottom: 5rem;
		align-items: start;
	}

	.program-card-v2 {
		background: #fff;
		border-radius: 14px;
		overflow: hidden;
		box-shadow: 0 8px 25px rgba(0, 0, 0, 0.08);
		border: 1px solid rgba(0, 59, 43, 0.1);
		display: flex;
		flex-direction: column;
		transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
		position: relative;
	}

	.program-card-v2:hover {
		box-shadow: 0 16px 40px rgba(0, 0, 0, 0.14);
		border-color: rgba(0, 59, 43, 0.3);
	}

	.program-card-v2.featured-card {
		border: 2px solid var(--accent-red);
		box-shadow: 0 10px 30px rgba(226, 10, 23, 0.15);
	}

	.featured-ribbon {
		position: absolute;
		top: 15px;
		right: -32px;
		background-color: var(--accent-red);
		color: #fff;
		font-size: 0.72rem;
		font-weight: 800;
		text-transform: uppercase;
		letter-spacing: 1px;
		padding: 0.35rem 2.5rem;
		transform: rotate(45deg);
		z-index: 10;
		box-shadow: 0 4px 10px rgba(0, 0, 0, 0.25);
	}

	/* Card Cover Trigger (Interactive Photo Tile) */
	.card-cover-trigger {
		cursor: pointer;
		user-select: none;
		outline: none;
	}

	.card-image-wrap {
		height: 320px;
		background-size: cover;
		background-position: center;
		position: relative;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		padding: 1.5rem;
		color: #fff;
		transition: transform 0.4s ease;
	}

	.card-cover-trigger:hover .card-image-wrap {
		/* subtle image zoom effect */
	}

	.card-image-overlay {
		position: absolute;
		inset: 0;
		background: linear-gradient(180deg, rgba(0, 0, 0, 0.3) 0%, rgba(0, 30, 20, 0.92) 100%);
		z-index: 1;
		transition: opacity 0.3s ease;
	}

	.card-top-badges {
		position: relative;
		z-index: 2;
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 0.5rem;
	}

	.badge-age {
		background: rgba(0, 59, 43, 0.9);
		backdrop-filter: blur(6px);
		color: #fff;
		font-size: 0.75rem;
		font-weight: 800;
		padding: 0.35rem 0.85rem;
		border-radius: 50px;
		border: 1px solid rgba(255, 255, 255, 0.35);
		text-transform: uppercase;
		letter-spacing: 0.5px;
	}

	.badge-level-chip {
		background: rgba(255, 255, 255, 0.15);
		backdrop-filter: blur(6px);
		color: var(--gold);
		font-size: 0.72rem;
		font-weight: 800;
		padding: 0.35rem 0.75rem;
		border-radius: 50px;
		border: 1px solid rgba(212, 175, 55, 0.4);
		text-transform: uppercase;
		letter-spacing: 0.5px;
	}

	.card-header-content {
		position: relative;
		z-index: 2;
	}

	.card-title {
		font-size: 1.6rem;
		color: #fff;
		margin: 0 0 1rem 0;
		line-height: 1.2;
		font-family: var(--font-headings);
		font-weight: 800;
		text-shadow: 0 2px 8px rgba(0, 0, 0, 0.5);
	}

	.card-expand-prompt {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		background: rgba(255, 255, 255, 0.15);
		backdrop-filter: blur(8px);
		border: 1px solid rgba(255, 255, 255, 0.4);
		color: #fff;
		padding: 0.5rem 1rem;
		border-radius: 50px;
		font-size: 0.84rem;
		font-weight: 700;
		transition: all 0.25s ease;
	}

	.card-cover-trigger:hover .card-expand-prompt {
		background: var(--gold);
		color: var(--text-dark);
		border-color: var(--gold);
	}

	.prompt-icon-bubble {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 22px;
		height: 22px;
		background: rgba(255, 255, 255, 0.25);
		border-radius: 50%;
		font-size: 0.7rem;
		transition: transform 0.3s ease;
	}

	.program-card-v2.expanded .prompt-icon-bubble {
		transform: rotate(180deg);
		background: var(--accent-red);
		color: #fff;
	}

	.program-card-v2.expanded .card-expand-prompt {
		background: rgba(0, 59, 43, 0.9);
		border-color: var(--gold);
		color: var(--gold);
	}

	/* Expandable Card Body */
	.card-body-collapsible {
		max-height: 0;
		overflow: hidden;
		opacity: 0;
		transition: max-height 0.45s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.35s ease;
		background: #fff;
	}

	.program-card-v2.expanded .card-body-collapsible {
		max-height: 1200px;
		opacity: 1;
	}

	.card-body-inner {
		padding: 1.75rem 1.5rem;
		display: flex;
		flex-direction: column;
		border-top: 1px solid rgba(0, 59, 43, 0.08);
	}

	.price-box {
		background-color: rgba(0, 59, 43, 0.05);
		border-radius: 8px;
		padding: 1rem 1.25rem;
		margin-bottom: 1.25rem;
		border-left: 4px solid var(--primary-green);
	}

