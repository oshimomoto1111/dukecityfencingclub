---
// Programs Component - Modern Tabbed Interactive Showcase
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<section class="programs-showcase-section" id="programs">
	<div class="programs-container">

		<!-- Section Header -->
		<div class="section-header">
			<span class="section-kicker">Transparent Pricing & Programs</span>
			<h2 class="section-title-custom">Choose Your Path on the Strip</h2>
			<p class="section-subtitle">
				Olympic-level instruction for every age, goal, and skill level. Select a program below to explore schedules, pricing, and trial classes.
			</p>
		</div>

		<!-- Interactive Segmented Tab Switcher -->
		<div class="program-tab-nav" role="tablist" aria-label="Fencing Programs">
			<button class="nav-tab active" data-target="panel-youth" role="tab" aria-selected="true" aria-controls="panel-youth">
				<i class="fas fa-child"></i>
				<span>Youth (6–9)</span>
			</button>
			<button class="nav-tab" data-target="panel-competitive" role="tab" aria-selected="false" aria-controls="panel-competitive">
				<i class="fas fa-trophy"></i>
				<span>Competitive (10+)</span>
			</button>
			<button class="nav-tab" data-target="panel-adults" role="tab" aria-selected="false" aria-controls="panel-adults">
				<i class="fas fa-users"></i>
				<span>Adults (16+)</span>
			</button>
			<button class="nav-tab" data-target="panel-bouting" role="tab" aria-selected="false" aria-controls="panel-bouting">
				<i class="fas fa-bolt"></i>
				<span>Open Bouting</span>
			</button>
			<button class="nav-tab" data-target="panel-private" role="tab" aria-selected="false" aria-controls="panel-private">
				<i class="fas fa-bullseye"></i>
				<span>Private & Events</span>
			</button>
			<button class="nav-tab tab-menaul" data-target="panel-menaul" role="tab" aria-selected="false" aria-controls="panel-menaul">
				<i class="fas fa-graduation-cap"></i>
				<span>Menaul School</span>
			</button>
		</div>

		<!-- Showcase Showcase Display Container -->
		<div class="showcase-content-wrapper">

			<!-- PANEL 1: YOUTH (AGES 6-9) -->
			<div class="showcase-panel active" id="panel-youth" role="tabpanel">
				<div class="showcase-card">
					<!-- Visual Column -->
					<div class="showcase-visual">
						<div class="visual-img" style={`background-image: url('${base}foto-jovenes-1.jpg');`}>
							<span class="visual-badge">Ages 6 – 9</span>
						</div>
						<div class="visual-meta">
							<div class="price-row">
								<span class="price-amount">$160</span>
								<span class="price-unit">/ month + tax</span>
							</div>
							<div class="trial-pill">
								<i class="fas fa-tag"></i> <strong>$10 Trial Class:</strong> Saturdays 9:45 AM
							</div>
							<button class="btn-showcase-primary open-booking" type="button">
								Book $10 Trial Class <i class="fas fa-arrow-right"></i>
							</button>
						</div>
					</div>

					<!-- Details Column -->
					<div class="showcase-details">
						<div class="program-type-badge">Beginners & Mini Musketeers</div>
						<h3>Youth Fencing Class</h3>
						<p class="program-summary">
							The ideal starting point for young champions. A high-energy, supportive environment where kids build agility, hand-eye coordination, mental focus, blade safety, and athletic confidence.
						</p>

						<!-- Clean Schedule Strip -->
						<div class="schedule-strip">
							<div class="schedule-tag">
								<i class="far fa-clock"></i> <strong>Mon & Wed:</strong> 4:30 PM – 6:00 PM
							</div>
							<div class="schedule-tag">
								<i class="fas fa-medal"></i> <strong>Sat Tournament:</strong> 11:00 AM – 2:00 PM
							</div>
						</div>

						<!-- Inclusions -->
						<div class="inclusions-block">
							<h4>What's Included:</h4>
							<ul class="inclusions-list">
								<li><i class="fas fa-check"></i> Complete protective gear & weapons provided for all new students</li>
								<li><i class="fas fa-check"></i> Fundamental footwork, point control, and safety etiquette</li>
								<li><i class="fas fa-check"></i> Free participation in weekly Saturday morning practice tournaments</li>
								<li><i class="fas fa-check"></i> Certified youth coaching focused on positive sportsmanship</li>
							</ul>
						</div>
					</div>
				</div>
			</div>

			<!-- PANEL 2: COMPETITIVE (AGES 10+) -->
			<div class="showcase-panel" id="panel-competitive" role="tabpanel">
				<div class="showcase-card featured-border">
					<!-- Visual Column -->
					<div class="showcase-visual">
						<div class="visual-img" style={`background-image: url('${base}foto-competitivo-1.jpg');`}>
							<span class="visual-badge badge-red">Ages 10+ • Intermediate / Advanced</span>
						</div>
						<div class="visual-meta">
							<div class="price-row">
								<span class="price-amount">$230</span>
								<span class="price-unit">/ month + tax</span>
							</div>
							<div class="trial-pill">
								<i class="fas fa-tag"></i> <strong>$10 Trial Session:</strong> Saturdays 12:30 PM
							</div>
							<button class="btn-showcase-primary open-booking" type="button">
								Book Competitive Trial <i class="fas fa-arrow-right"></i>
							</button>
						</div>
					</div>

					<!-- Details Column -->
					<div class="showcase-details">
						<div class="program-type-badge badge-popular">★ Most Popular Program</div>
						<h3>Competitive Epee Program</h3>
						<p class="program-summary">
							Engineered for ambitious fencers dedicated to regional (ROC/RYC) and national (NAC) tournament podiums. Advanced tactical decision-making, athletic cross-conditioning, and tournament bouting.
						</p>

						<!-- Schedule Strip -->
						<div class="schedule-strip">
							<div class="schedule-tag">
								<i class="far fa-clock"></i> <strong>Tue & Thu:</strong> 5:30 PM – 7:30 PM
							</div>
							<div class="schedule-tag">
								<i class="fas fa-bolt"></i> <strong>Mon–Thu:</strong> Open Bouting (Included Free)
							</div>
							<div class="schedule-tag">
								<i class="fas fa-dumbbell"></i> <strong>Sat:</strong> Conditioning (10:30 AM) & Tournaments
							</div>
						</div>

						<!-- Inclusions -->
						<div class="inclusions-block">
							<h4>What's Included:</h4>
							<ul class="inclusions-list">
								<li><i class="fas fa-check"></i> Unlimited Open Bouting floor access with full electric scoring reels</li>
								<li><i class="fas fa-check"></i> Directed by 3-Time Olympian & World Medalist Courtney Hurley</li>
								<li><i class="fas fa-check"></i> Strategic bout video analysis and national ranking development</li>
								<li><i class="fas fa-check"></i> National tournament coaching & collegiate NCAA recruiting pathway</li>
							</ul>
						</div>
					</div>
				</div>
			</div>

			<!-- PANEL 3: ADULTS (AGES 16+) -->
			<div class="showcase-panel" id="panel-adults" role="tabpanel">
				<div class="showcase-card">
					<!-- Visual Column -->
					<div class="showcase-visual">
						<div class="visual-img" style={`background-image: url('${base}foto-adultos-1.jpg');`}>
							<span class="visual-badge">Ages 16+ • All Levels</span>
						</div>
						<div class="visual-meta">
							<div class="price-row">
								<span class="price-amount">$140</span>
								<span class="price-unit">/ month + tax</span>
							</div>
							<div class="trial-pill">
								<i class="fas fa-tag"></i> <strong>$25 Intro & First Class:</strong> Mondays 6:30 PM
							</div>
							<button class="btn-showcase-primary open-booking" type="button">
								Book $25 Adult Trial <i class="fas fa-arrow-right"></i>
							</button>
						</div>
					</div>

					<!-- Details Column -->
					<div class="showcase-details">
						<div class="program-type-badge">Fitness, Strategy & Community</div>
						<h3>Adult Recreation Class</h3>
						<p class="program-summary">
							A premier cardiovascular workout and physical chess match on the strip. Led by Coach Andy, this class welcomes both complete adult beginners and experienced fencers looking for recreation and fitness.
						</p>

						<!-- Schedule Strip -->
						<div class="schedule-strip">
							<div class="schedule-tag">
								<i class="far fa-clock"></i> <strong>Mondays:</strong> 7:00 PM – 8:00 PM (Intro 6:30 PM)
							</div>
							<div class="schedule-tag">
								<i class="fas fa-medal"></i> <strong>Saturdays:</strong> Club Tournaments 11:00 AM – 2:00 PM
							</div>
						</div>

						<!-- Inclusions -->
						<div class="inclusions-block">
							<h4>What's Included:</h4>
							<ul class="inclusions-list">
								<li><i class="fas fa-check"></i> Zero experience needed — all protective gear and epees supplied</li>
								<li><i class="fas fa-check"></i> High-calorie burn, core strengthening, and tactical agility drills</li>
								<li><i class="fas fa-check"></i> Welcoming, social, and supportive adult fencing community</li>
								<li><i class="fas fa-check"></i> Saturday tournament sparring and practice bouts included</li>
							</ul>
						</div>
					</div>
				</div>
			</div>

			<!-- PANEL 4: OPEN BOUTING -->
			<div class="showcase-panel" id="panel-bouting" role="tabpanel">
				<div class="showcase-card">
					<!-- Visual Column -->
					<div class="showcase-visual">
						<div class="visual-img" style={`background-image: url('${base}foto-competitivo-2.jpg');`}>
							<span class="visual-badge">Floor Access & Sparring</span>
						</div>
						<div class="visual-meta">
							<div class="price-row">
								<span class="price-amount">$140</span>
								<span class="price-unit">/mo (or $20/day pass)</span>
							</div>
							<div class="trial-pill">
								<i class="fas fa-plus-circle"></i> <strong>$35/mo Add-on</strong> for Youth & Adult Rec
							</div>
							<button class="btn-showcase-primary open-booking" type="button">
								Get Day Pass / Register <i class="fas fa-arrow-right"></i>
							</button>
						</div>
					</div>

					<!-- Details Column -->
					<div class="showcase-details">
						<div class="program-type-badge">Electric Strips & Cross-Training</div>
						<h3>Open Bouting & Cross-Training</h3>
						<p class="program-summary">
							Dedicated open floor time with electric scoring equipment to bout freely against diverse opponents, sharpen tactical instincts, and participate in Friday athletic conditioning.
						</p>

						<!-- Schedule Strip -->
						<div class="schedule-strip">
							<div class="schedule-tag">
								<i class="far fa-clock"></i> <strong>Mon & Wed:</strong> 6:00 PM – 7:30 PM
							</div>
							<div class="schedule-tag">
								<i class="far fa-clock"></i> <strong>Tue & Thu:</strong> 6:30 PM – 7:30 PM
							</div>
							<div class="schedule-tag">
								<i class="fas fa-dumbbell"></i> <strong>Fridays:</strong> Athletic Cross-Training
							</div>
						</div>

						<!-- Inclusions -->
						<div class="inclusions-block">
							<h4>What's Included:</h4>
							<ul class="inclusions-list">
								<li><i class="fas fa-check"></i> Full electric scoring machines and grounded fencing strips</li>
								<li><i class="fas fa-check"></i> Included completely free for Competitive Program members</li>
								<li><i class="fas fa-check"></i> Visiting and traveling fencers always welcome with $20 daily drop-in</li>
								<li><i class="fas fa-check"></i> Friday fencing-specific strength & conditioning workouts</li>
							</ul>
						</div>
					</div>
				</div>
			</div>

			<!-- PANEL 5: PRIVATE LESSONS & TOURNAMENTS -->
			<div class="showcase-panel" id="panel-private" role="tabpanel">
				<div class="showcase-card">
					<!-- Visual Column -->
					<div class="showcase-visual">
						<div class="visual-img" style={`background-image: url('${base}foto-jovenes-2.jpg');`}>
							<span class="visual-badge">Ages 6+ • 1-on-1 Mastery</span>
						</div>
						<div class="visual-meta">
							<div class="price-row">
								<span class="price-amount">$45</span>
								<span class="price-unit">/ lesson</span>
							</div>
							<div class="trial-pill">
								<i class="fas fa-box-open"></i> <strong>4-Lesson Pack:</strong> $165 + tax (Save $15)
							</div>
							<button class="btn-showcase-primary open-booking" type="button">
								Book Private Lesson <i class="fas fa-arrow-right"></i>
							</button>
						</div>
					</div>

					<!-- Details Column -->
					<div class="showcase-details">
						<div class="program-type-badge">Personalized Coaching & Weekend Bouts</div>
						<h3>Private Lessons & Club Tournaments</h3>
						<p class="program-summary">
							Accelerate individual technical mastery, hand speed, and tactical game planning with dedicated 1-on-1 coaching sessions, plus real tournament practice every Saturday.
						</p>

						<!-- Schedule Strip -->
						<div class="schedule-strip">
							<div class="schedule-tag">
								<i class="far fa-calendar-alt"></i> <strong>Private Lessons:</strong> Mon–Sat by Appointment
							</div>
							<div class="schedule-tag">
								<i class="fas fa-trophy"></i> <strong>Saturday Tournaments:</strong> 11:00 AM ($20 non-members)
							</div>
						</div>

						<!-- Inclusions -->
						<div class="inclusions-block">
							<h4>What's Included:</h4>
							<ul class="inclusions-list">
								<li><i class="fas fa-check"></i> 1-on-1 blade precision, distance calibration, and tactical drilling</li>
								<li><i class="fas fa-check"></i> Customized tournament preparation tailored to your fencing style</li>
								<li><i class="fas fa-check"></i> Easy online booking and package management through GymDesk portal</li>
								<li><i class="fas fa-check"></i> Saturday poule & direct elimination tournament matches</li>
							</ul>
						</div>
					</div>
				</div>
			</div>

			<!-- PANEL 6: MENAUL SCHOOL PARTNERSHIP -->
			<div class="showcase-panel" id="panel-menaul" role="tabpanel">
				<div class="showcase-card menaul-theme-card">
					<!-- Visual Column -->
					<div class="showcase-visual menaul-visual">
						<div class="visual-img" style={`background-image: url('${base}courtney.jpg');`}>
							<span class="visual-badge badge-gold">Grades 6–12 • Residential & Day</span>
						</div>
						<div class="visual-meta">
							<div class="menaul-director-tag">
								<strong>Courtney Hurley</strong>
								<span>3x Olympian • Olympic Medalist • 2x NCAA Champion</span>
							</div>
							<div class="menaul-btn-stack">
								<a href="https://www.menaulschool.org/admission/apply/" target="_blank" rel="noopener noreferrer" class="btn-showcase-primary btn-menaul-primary">
									Apply to Menaul School <i class="fas fa-external-link-alt"></i>
								</a>
								<a href="https://www.menaulschool.org/wp-content/uploads/sites/51/2025/11/Fencingv3-final.pdf" target="_blank" rel="noopener noreferrer" class="btn-menaul-outline">
									<i class="fas fa-file-pdf"></i> Download Brochure
								</a>
							</div>
						</div>
					</div>

					<!-- Details Column -->
					<div class="showcase-details">
						<div class="program-type-badge badge-menaul">🎓 Fencing – Find Your Edge</div>
						<h3>Menaul School Panther Fencing Academy</h3>
						<p class="program-summary">
							The <strong>first high school residential & day fencing program in the USA</strong>. Students receive elite daily training 5 days a week directly under Olympic Medalist Courtney Hurley integrated into their college-prep school day.
						</p>

						<!-- 4 Mini Pillar Cards -->
						<div class="menaul-mini-grid">
							<div class="mini-pillar">
								<i class="fas fa-graduation-cap"></i>
								<div>
									<strong>NCAA D1 & Ivy League Pathway</strong>
									<span>Recruitment pipeline to Stanford, Notre Dame, Harvard, Princeton</span>
								</div>
							</div>
							<div class="mini-pillar">
								<i class="fas fa-clock"></i>
								<div>
									<strong>Flexible Academic Schedule</strong>
									<span>Rigorous curriculum structured around daily training and ROC/NAC travel</span>
								</div>
							</div>
							<div class="mini-pillar">
								<i class="fas fa-mountain"></i>
								<div>
									<strong>High-Altitude Advantage</strong>
									<span>Mile-high (5,312 ft) cardiovascular endurance training edge</span>
								</div>
							</div>
							<div class="mini-pillar">
								<i class="fas fa-award"></i>
								<div>
									<strong>Tuition-Free NM Universities</strong>
									<span>Qualify for NM Lottery Scholarship for 100% tuition at UNM</span>
								</div>
							</div>
						</div>

						<!-- Direct Info -->
						<div class="menaul-footnote">
							<span><i class="fas fa-bed"></i> <strong>Boarding:</strong> On-campus dorms</span>
							<span><i class="fas fa-school"></i> <strong>Day School:</strong> Local NM students</span>
							<span><i class="fas fa-envelope"></i> <strong>Director:</strong> <a href="mailto:CHurley@menaulschool.org">CHurley@menaulschool.org</a></span>
						</div>
					</div>
				</div>
			</div>

		</div>

		<!-- Sleek Minimalist Discounts Strip -->
		<div class="discounts-compact-strip">
			<div class="discounts-compact-label">
				<i class="fas fa-tags"></i>
				<span>Member Perks & Discounts:</span>
			</div>
			<div class="discounts-compact-items">
				<div class="compact-disc-item">
					<span class="disc-pct">25% OFF</span>
					<span class="disc-txt">Sibling & Family</span>
				</div>
				<div class="compact-disc-divider">•</div>
				<div class="compact-disc-item">
					<span class="disc-pct">10% OFF</span>
					<span class="disc-txt">Active Military & Veterans</span>
				</div>
				<div class="compact-disc-divider">•</div>
				<div class="compact-disc-item">
					<span class="disc-pct">10% OFF</span>
					<span class="disc-txt">College Students</span>
				</div>
			</div>
		</div>

	</div>
</section>

<style>
	.programs-showcase-section {
		padding: var(--section-padding);
		background-color: var(--bg-cream);
	}

	.programs-container {
		max-width: 1200px;
		margin: 0 auto;
	}

	/* Section Header */
	.section-header {
		text-align: center;
		max-width: 760px;
		margin: 0 auto 2.5rem;
	}

	.section-kicker {
		display: inline-block;
		color: var(--accent-red);
		font-weight: 800;
		font-size: 0.85rem;
		text-transform: uppercase;
		letter-spacing: 2px;
		margin-bottom: 0.5rem;
	}

	.section-title-custom {
		font-size: 2.6rem;
		color: var(--primary-green);
		margin-bottom: 0.85rem;
		line-height: 1.15;
	}

	.section-subtitle {
		font-size: 1.05rem;
		color: var(--text-dark);
		opacity: 0.85;
		line-height: 1.55;
	}

	/* Interactive Segmented Tab Nav */
	.program-tab-nav {
		display: flex;
		justify-content: center;
		gap: 0.6rem;
		flex-wrap: wrap;
		margin-bottom: 2rem;
		background: #fff;
		padding: 0.5rem;
		border-radius: 50px;
		box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
		border: 1px solid rgba(0, 59, 43, 0.1);
		max-width: 1050px;
		margin-left: auto;
		margin-right: auto;
	}

	.nav-tab {
		background: transparent;
		color: var(--text-dark);
		border: none;
		padding: 0.75rem 1.4rem;
		border-radius: 50px;
		font-family: var(--font-headings);
		font-weight: 700;
		font-size: 0.9rem;
		cursor: pointer;
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
		opacity: 0.8;
	}

	.nav-tab i {
		font-size: 0.95rem;
		color: var(--primary-green);
		transition: color 0.25s ease;
	}

	.nav-tab:hover {
		opacity: 1;
		background-color: rgba(0, 59, 43, 0.06);
	}

	.nav-tab.active {
		background-color: var(--primary-green);
		color: #fff;
		opacity: 1;
		box-shadow: 0 4px 12px rgba(0, 59, 43, 0.3);
	}

	.nav-tab.active i {
		color: var(--gold);
	}

	.nav-tab.tab-menaul.active {
		background: linear-gradient(135deg, var(--primary-green) 0%, #002b1f 100%);
		border: 1px solid var(--gold);
	}

	/* Showcase Container */
	.showcase-content-wrapper {
		margin-bottom: 2.5rem;
		position: relative;
	}

	.showcase-panel {
		display: none;
		animation: fadeInSlide 0.35s ease-out forwards;
	}

	.showcase-panel.active {
		display: block;
	}

	@keyframes fadeInSlide {
		from {
			opacity: 0;
			transform: translateY(12px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	/* Showcase Card - 2 Columns */
	.showcase-card {
		background: #fff;
		border-radius: 16px;
		overflow: hidden;
		box-shadow: 0 12px 35px rgba(0, 0, 0, 0.08);
		border: 1px solid rgba(0, 59, 43, 0.1);
		display: grid;
		grid-template-columns: 420px 1fr;
		min-height: 480px;
	}

	.showcase-card.featured-border {
		border: 2px solid var(--accent-red);
		box-shadow: 0 15px 40px rgba(226, 10, 23, 0.12);
	}

	/* Left Visual Column */
	.showcase-visual {
		background: #0f241a;
		display: flex;
		flex-direction: column;
		color: #fff;
		position: relative;
	}

	.visual-img {
		height: 240px;
		background-size: cover;
		background-position: center;
		position: relative;
		display: flex;
		align-items: flex-start;
		padding: 1.25rem;
	}

	.visual-img::after {
		content: '';
		position: absolute;
		inset: 0;
		background: linear-gradient(180deg, rgba(0, 0, 0, 0.15) 0%, rgba(15, 36, 26, 0.9) 100%);
	}

	.visual-badge {
		position: relative;
		z-index: 2;
		background: rgba(0, 59, 43, 0.9);
		backdrop-filter: blur(8px);
		color: #fff;
		font-size: 0.78rem;
		font-weight: 800;
		padding: 0.35rem 0.85rem;
		border-radius: 50px;
