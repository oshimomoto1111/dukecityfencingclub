	.t-event-name {
		font-size: 1.15rem;
		color: #fff;
		margin: 0 0 0.65rem 0;
		font-weight: 800;
	}

	.t-event-fee {
		font-size: 0.88rem;
		color: #ddd;
	}

	.t-event-fee strong {
		color: var(--gold);
		font-size: 1.05rem;
	}

	.fee-sub {
		color: #999;
		font-size: 0.78rem;
