<script>
	// Tournament Full-Screen Modal Logic
	const tournamentModal = document.getElementById('tournamentModal');
	const openModalBtn = document.getElementById('openTournamentModalBtn');
	const imgPreviewCard = document.querySelector('.featured-img-preview');
	const closeModalBtn = document.getElementById('closeTournamentModalBtn');
	const closeModalBottomBtn = document.getElementById('closeTournamentModalBottomBtn');

	const openModal = () => {
		tournamentModal?.classList.add('active');
		tournamentModal?.setAttribute('aria-hidden', 'false');
		document.body.style.overflow = 'hidden';
	};

	const closeModal = () => {
		tournamentModal?.classList.remove('active');
		tournamentModal?.setAttribute('aria-hidden', 'true');
		document.body.style.overflow = '';
	};

	openModalBtn?.addEventListener('click', (e) => {
		e.preventDefault();
		openModal();
	});

	imgPreviewCard?.addEventListener('click', () => {
		openModal();
	});

	closeModalBtn?.addEventListener('click', closeModal);
	closeModalBottomBtn?.addEventListener('click', closeModal);

	window.addEventListener('click', (e) => {
		if (e.target === tournamentModal) {
			closeModal();
		}
	});

	window.addEventListener('keydown', (e) => {
		if (e.key === 'Escape' && tournamentModal?.classList.contains('active')) {
			closeModal();
		}
	});
</script>
