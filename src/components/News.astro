<script>
	// Modals Elements
	const tournamentModal = document.getElementById('tournamentModal');
	const openTournamentBtn = document.getElementById('openTournamentModalBtn');
	const tournamentImgPreview = document.getElementById('tournamentResultsImgPreview');
	const closeTournamentBtn = document.getElementById('closeTournamentModalBtn');
	const closeTournamentBottomBtn = document.getElementById('closeTournamentModalBottomBtn');

	const fallCupModal = document.getElementById('fallCupModal');
	const openFallCupBtn = document.getElementById('openFallCupModalBtn');
	const fallCupImgPreview = document.getElementById('fallCupImgPreview');
	const closeFallCupBtn = document.getElementById('closeFallCupModalBtn');
	const closeFallCupBottomBtn = document.getElementById('closeFallCupModalBottomBtn');

	const openModal = (modal: HTMLElement | null) => {
		if (!modal) return;
		modal.classList.add('active');
		modal.setAttribute('aria-hidden', 'false');
		document.body.style.overflow = 'hidden';
	};

	const closeModal = (modal: HTMLElement | null) => {
		if (!modal) return;
		modal.classList.remove('active');
		modal.setAttribute('aria-hidden', 'true');
		document.body.style.overflow = '';
	};

	// Event listeners for Tournament Recap (Air Force ROC)
	openTournamentBtn?.addEventListener('click', (e) => {
		e.preventDefault();
		openModal(tournamentModal);
	});
	tournamentImgPreview?.addEventListener('click', () => {
		openModal(tournamentModal);
	});
	closeTournamentBtn?.addEventListener('click', () => closeModal(tournamentModal));
	closeTournamentBottomBtn?.addEventListener('click', () => closeModal(tournamentModal));

	// Event listeners for First Fall Cup
	openFallCupBtn?.addEventListener('click', (e) => {
		e.preventDefault();
		openModal(fallCupModal);
	});
	fallCupImgPreview?.addEventListener('click', () => {
		openModal(fallCupModal);
	});
	closeFallCupBtn?.addEventListener('click', () => closeModal(fallCupModal));
	closeFallCupBottomBtn?.addEventListener('click', () => closeModal(fallCupModal));

	// Overlay clicks
	window.addEventListener('click', (e) => {
		if (e.target === tournamentModal) closeModal(tournamentModal);
		if (e.target === fallCupModal) closeModal(fallCupModal);
	});

	// ESC key closes any open modal
	window.addEventListener('keydown', (e) => {
		if (e.key === 'Escape') {
			if (tournamentModal?.classList.contains('active')) closeModal(tournamentModal);
			if (fallCupModal?.classList.contains('active')) closeModal(fallCupModal);
		}
	});
</script>
