---
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<section class="news-section" id="news">
	<div class="news-container">
		
		<div class="news-header">
			<span class="news-kicker">Latest From The Strip</span>
			<h2 class="section-title-custom">News, Events & Announcements</h2>
			<p class="news-subtitle">
				Follow our competitive results, upcoming camps, and club notices as our fencers compete locally and nationally.
			</p>
		</div>

		<div class="bento-grid">
			
			<!-- Card 1: Tournament Achievements (Featured Slot) -->
			<div class="bento-card bento-card-featured">
				<div class="card-glow-bg"></div>
				<div class="bento-card-inner">
					<div class="tag-row">
						<span class="news-tag tag-achievement"><i class="fas fa-trophy"></i> Tournament Results</span>
						<span class="status-pill"><i class="fas fa-circle-dot"></i> Updated Seasonally</span>
					</div>

					<div class="bento-card-body">
						<div class="empty-icon-wrap">
							<i class="fas fa-medal"></i>
						</div>
						<h3 class="bento-title">Competitive Tournament Results</h3>
						<p class="bento-desc">
							Podium finishes, regional medal results, and national qualification points from our travel team will be published here following each major competition.
						</p>
					</div>

					<div class="bento-card-footer">
						<span class="placeholder-notice"><i class="fas fa-info-circle"></i> Check back soon for upcoming tournament recaps</span>
					</div>
				</div>
			</div>

			<!-- Columna lateral: Eventos y Avisos -->
			<div class="bento-side">
				
				<!-- Card 2: Upcoming Events & Clinics -->
				<div class="bento-card bento-card-small">
					<div class="card-glow-bg"></div>
					<div class="bento-card-inner">
						<div class="tag-row">
							<span class="news-tag tag-event"><i class="fas fa-calendar-alt"></i> Upcoming Events</span>
						</div>

						<div class="bento-card-body">
							<h4 class="bento-title-small">Camps, Clinics & Workshops</h4>
							<p class="bento-desc-small">
								Intensive seasonal training camps, referee seminars, and guest master clinics will be announced here with online registration links.
							</p>
						</div>

						<div class="bento-card-footer">
							<span class="placeholder-notice"><i class="fas fa-clock"></i> Dates to be announced</span>
						</div>
					</div>
				</div>

				<!-- Card 3: Club Announcements -->
				<div class="bento-card bento-card-small">
					<div class="card-glow-bg"></div>
					<div class="bento-card-inner">
						<div class="tag-row">
							<span class="news-tag tag-announcement"><i class="fas fa-bullhorn"></i> Club Notice</span>
						</div>

						<div class="bento-card-body">
							<h4 class="bento-title-small">Facility & Schedule Updates</h4>
							<p class="bento-desc-small">
								Important member notices, holiday gym hours, and open armory schedules will appear in this bulletin.
							</p>
						</div>

						<div class="bento-card-footer">
							<span class="placeholder-notice"><i class="fas fa-check-circle"></i> Standard schedule currently in effect</span>
						</div>
					</div>
				</div>

			</div>

		</div>

	</div>
</section>

<style>
	.news-section {
		padding: var(--section-padding);
		background-color: #0d1e16;
		color: var(--text-light);
		position: relative;
	}

	.news-container {
		max-width: 1240px;
		margin: 0 auto;
	}

	.news-header {
		text-align: center;
		max-width: 760px;
		margin: 0 auto 3.5rem;
	}

	.news-kicker {
		display: inline-block;
		color: var(--gold);
		font-weight: 800;
		font-size: 0.85rem;
		text-transform: uppercase;
		letter-spacing: 2px;
		margin-bottom: 0.5rem;
	}

	.section-title-custom {
		font-size: 2.5rem;
		color: var(--bg-cream);
		margin-bottom: 0.85rem;
		font-family: var(--font-headings);
		font-weight: 800;
		line-height: 1.15;
	}

	.news-subtitle {
		font-size: 1.05rem;
		opacity: 0.85;
		line-height: 1.6;
		color: #e0e0e0;
	}

	/* Bento Grid Layout */
	.bento-grid {
		display: grid;
		grid-template-columns: 1.2fr 0.8fr;
		gap: 2rem;
		margin-bottom: 2.5rem;
	}

	.bento-side {
		display: flex;
		flex-direction: column;
		gap: 2rem;
	}

	/* Bento Card Styling */
	.bento-card {
		background: rgba(255, 255, 255, 0.03);
		border: 1px solid rgba(255, 255, 255, 0.1);
		border-radius: 16px;
		position: relative;
		overflow: hidden;
		transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
		display: flex;
		flex-direction: column;
	}

	.bento-card:hover {
		transform: translateY(-3px);
		border-color: rgba(212, 175, 55, 0.4);
		box-shadow: 0 12px 30px rgba(0, 0, 0, 0.4);
	}

	.bento-card-featured {
		min-height: 440px;
		border: 1px solid rgba(212, 175, 55, 0.25);
		background: linear-gradient(145deg, rgba(0, 59, 43, 0.3) 0%, rgba(0, 0, 0, 0.4) 100%);
	}

	.bento-card-small {
		flex: 1;
		min-height: 205px;
	}

	.bento-card-inner {
		padding: 2rem;
		display: flex;
		flex-direction: column;
		height: 100%;
		position: relative;
		z-index: 2;
	}

	.tag-row {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 1.5rem;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.news-tag {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font-size: 0.75rem;
		font-weight: 800;
		text-transform: uppercase;
		padding: 0.35rem 0.85rem;
		border-radius: 50px;
		letter-spacing: 0.5px;
	}

	.tag-achievement {
		background: rgba(226, 10, 23, 0.15);
		color: var(--accent-red);
		border: 1px solid rgba(226, 10, 23, 0.4);
	}

	.tag-event {
		background: rgba(212, 175, 55, 0.15);
		color: var(--gold);
		border: 1px solid rgba(212, 175, 55, 0.4);
	}

	.tag-announcement {
		background: rgba(0, 59, 43, 0.6);
		color: #a3e6cd;
		border: 1px solid rgba(0, 59, 43, 0.9);
	}

	.status-pill {
		font-size: 0.75rem;
		color: rgba(255, 255, 255, 0.6);
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
	}

	.status-pill i {
		color: var(--gold);
		font-size: 0.55rem;
	}

	.bento-card-body {
		flex-grow: 1;
		margin-bottom: 1.5rem;
	}

	.empty-icon-wrap {
		width: 52px;
		height: 52px;
		background: rgba(212, 175, 55, 0.1);
		border: 1px solid rgba(212, 175, 55, 0.3);
		border-radius: 12px;
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 1.5rem;
		color: var(--gold);
		margin-bottom: 1.25rem;
	}

	.bento-title {
		font-size: 1.6rem;
		color: var(--bg-cream);
		margin-bottom: 0.75rem;
		font-family: var(--font-headings);
		font-weight: 800;
		line-height: 1.25;
	}

	.bento-title-small {
		font-size: 1.25rem;
		color: var(--bg-cream);
		margin-bottom: 0.5rem;
		font-family: var(--font-headings);
		font-weight: 800;
	}

	.bento-desc {
		font-size: 0.95rem;
		color: #ccc;
		line-height: 1.6;
		max-width: 480px;
	}

	.bento-desc-small {
		font-size: 0.88rem;
		color: #bbb;
		line-height: 1.5;
	}

	.bento-card-footer {
		margin-top: auto;
		padding-top: 1rem;
		border-top: 1px solid rgba(255, 255, 255, 0.08);
	}

	.placeholder-notice {
		font-size: 0.8rem;
		color: rgba(255, 255, 255, 0.6);
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
	}

	.placeholder-notice i {
		color: var(--gold);
	}

	@media (max-width: 900px) {
		.bento-grid {
			grid-template-columns: 1fr;
		}
		.section-title-custom {
			font-size: 2.1rem;
		}
	}
</style>
