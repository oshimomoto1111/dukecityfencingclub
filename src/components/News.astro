---
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;

const tournamentPhotos = [
	{
		src: `${base}tournament-zoe-medals.jpg`,
		alt: "Zoe with 3 medals at the Air Force ROC & RJCC",
		title: "Zoe with 3 Medals",
		caption: "Zoe celebrating her triple-medal finish (Cadet, Div II, Junior) and earning her C26 rating!",
		tag: "Triple Medalist"
	},
	{
		src: `${base}tournament-zoe-podium-1.jpg`,
		alt: "Zoe on the Medal Podium (Cadet & Div II) at US Air Force Academy",
		title: "Podium Ceremony — Cadet & Div II",
		caption: "Zoe on the medal podium at the United States Air Force Academy in Colorado.",
		tag: "Podium Finish"
	},
	{
		src: `${base}tournament-zoe-podium-2.jpg`,
		alt: "Zoe on the Junior Medal Podium at US Air Force Academy",
		title: "Podium Ceremony — Junior Women's Epee",
		caption: "Zoe on the medal podium for Junior Women's Epee at the Air Force RJCC.",
		tag: "Podium Finish"
	},
	{
		src: `${base}tournament-zoe-coaches.jpg`,
		alt: "Zoe with Head Coach Courtney Hurley and Coach Bella",
		title: "With Coaches Courtney & Bella",
		caption: "Zoe with Head Coach Courtney Hurley (Olympic Medalist) & Coach Bella at the tournament venue.",
		tag: "Team & Coaching"
	},
	{
		src: `${base}tournament-mark-results.jpg`,
		alt: "Mark Kramer 3rd Place Veteran Men's Epee official results",
		title: "Mark Kramer Official Results",
		caption: "Mark Kramer securing 3rd Place (Tie) in Veteran Men's Epee and earning his C26 rating.",
		tag: "Vet Epee Results"
	},
];
---

<section class="news-section" id="news">
	<div class="news-container">
		
		<div class="news-header">
			<span class="news-kicker">Latest From The Strip</span>
			<h2 class="section-title-custom">News, Events & Tournament Results</h2>
			<p class="news-subtitle">
				Follow our competitive results, register for upcoming home tournaments, and keep up with Duke City Fencing Club on and off the strip.
			</p>
		</div>

		<!-- Bento Grid (2 Featured Cards + Wide Club Notice Banner) -->
		<div class="bento-grid">
			
			<!-- Card 1: Featured Upcoming Home Tournament — FIRST FALL CUP 2026 -->
			<article class="bento-card bento-card-featured bento-card-fall-cup">
				<div class="card-glow-bg glow-autumn"></div>
				
				<div class="featured-card-layout">
					<!-- Preview Image with Badge -->
					<div class="featured-img-preview fall-cup-preview" id="fallCupImgPreview" style={`background-image: url('${base}first-fall-cup-flyer.jpg');`}>
						<div class="img-preview-overlay"></div>
						<div class="preview-badge-row">
							<span class="news-tag tag-fall-cup"><i class="fas fa-trophy"></i> Home Tournament</span>
							<span class="date-badge-pill"><i class="fas fa-calendar-alt"></i> Oct 3, 2026</span>
						</div>
						<div class="preview-cta-prompt prompt-gold">
							<span><i class="fas fa-expand-alt"></i> View Schedule & Full Flyer</span>
						</div>
					</div>

					<!-- Content Preview -->
					<div class="bento-card-inner">
						<div class="tag-row">
							<span class="location-pill"><i class="fas fa-map-marker-alt"></i> Menaul Fencing Gym • ABQ</span>
							<span class="status-pill status-open"><i class="fas fa-check-circle"></i> Registration Open</span>
						</div>

						<div class="bento-card-body">
							<h3 class="bento-title">Duke City Presents: First Fall Cup</h3>
							<p class="bento-desc">
								Our very first home tournament at Duke City Fencing Club! Sanctioned Epee competition across Junior, Y10, Senior Open, and Y14 events.
							</p>

							<!-- Mini Schedule Chips -->
							<div class="mini-achievements-list">
								<span class="mini-chip event-chip">⚡ 8:00 AM • Junior Mixed Epee</span>
								<span class="mini-chip event-chip">⚡ 10:00 AM • Y10 Mixed Epee</span>
								<span class="mini-chip event-chip">⚡ 11:30 AM • Senior Open Mixed Epee</span>
								<span class="mini-chip event-chip">⚡ 2:00 PM • Y14 Mixed Epee</span>
								<span class="mini-chip gold-chip">🎟️ $20 Reg + Event Fees</span>
							</div>
						</div>

						<div class="bento-card-footer dual-action-footer">
							<a 
								href="https://www.askfred.net/tournaments/7467479b-79eb-4e27-9dfb-c34e9fc521a0" 
								target="_blank" 
								rel="noopener noreferrer" 
								class="btn-askfred-direct"
							>
								<span>Register on AskFRED</span> <i class="fas fa-external-link-alt"></i>
							</a>
							<button class="btn-open-modal-secondary" id="openFallCupModalBtn" type="button">
								<span>View Details</span> <i class="fas fa-arrow-right"></i>
							</button>
						</div>
					</div>
				</div>
			</article>

			<!-- Card 2: Featured Tournament Results Teaser (Air Force ROC & RJCC) -->
			<article class="bento-card bento-card-featured">
				<div class="card-glow-bg"></div>
				
				<div class="featured-card-layout">
					<!-- Preview Image with Badge -->
					<div class="featured-img-preview" id="tournamentResultsImgPreview" style={`background-image: url('${base}tournament-zoe-medals.jpg');`}>
						<div class="img-preview-overlay"></div>
						<div class="preview-badge-row">
							<span class="news-tag tag-achievement"><i class="fas fa-medal"></i> Tournament Results</span>
							<span class="photo-count-pill"><i class="fas fa-camera"></i> 5 Photos</span>
						</div>
						<div class="preview-cta-prompt">
							<span><i class="fas fa-expand-alt"></i> Click to Open Full Recap</span>
						</div>
					</div>

					<!-- Content Preview -->
					<div class="bento-card-inner">
						<div class="tag-row">
							<span class="location-pill"><i class="fas fa-map-marker-alt"></i> Colorado Springs, CO</span>
							<span class="status-pill"><i class="fas fa-circle-dot"></i> Air Force ROC & RJCC</span>
						</div>

						<div class="bento-card-body">
							<h3 class="bento-title">Air Force ROC & RJCC: Triple Medals & C26 Ratings!</h3>
							<p class="bento-desc">
								Huge congratulations to <strong>Zoe</strong> (3rd Cadet, 3rd Div II, 7th Junior) and <strong>Mark Kramer</strong> (3rd Vet Men’s Epee) for earning their <strong>C26 ratings</strong> in Colorado!
							</p>

							<!-- Mini Badges List -->
							<div class="mini-achievements-list">
								<span class="mini-chip">🥉 Zoe: 3rd Cadet Women’s Epee</span>
								<span class="mini-chip">🥉 Zoe: 3rd Div II Women’s Epee</span>
								<span class="mini-chip">🎖️ Zoe: 7th Junior Women’s Epee</span>
								<span class="mini-chip">🥉 Mark Kramer: 3rd Vet Men’s Epee</span>
								<span class="mini-chip gold-chip">⭐ Both Earned C26 Ratings</span>
							</div>
						</div>

						<div class="bento-card-footer">
							<button class="btn-open-tournament-modal" id="openTournamentModalBtn" type="button">
								<span>View Full Recap & Photo Gallery</span> <i class="fas fa-arrow-right"></i>
							</button>
						</div>
					</div>
				</div>
			</article>

		</div>

		<!-- Bottom Wide Banner: Saturday Tournaments & Club Practice Notice -->
		<div class="bento-card bento-card-wide">
			<div class="card-glow-bg"></div>
			<div class="bento-card-inner wide-layout">
				<div class="wide-info">
					<div class="tag-row">
						<span class="news-tag tag-announcement"><i class="fas fa-bullhorn"></i> Weekly Club Notice</span>
						<span class="status-pill"><i class="fas fa-clock"></i> Every Non-Travel Weekend</span>
					</div>
					<h4 class="wide-title">Weekly Saturday Tournaments & Open Strip Practice</h4>
					<p class="wide-desc">
						In-house Saturday club tournaments run from <strong>11:00 AM – 2:00 PM</strong> at our Menaul School gym. All fencers, members, and visitors are welcome to sharpen their competitive skills.
					</p>
				</div>
				<div class="wide-actions">
					<span class="location-badge"><i class="fas fa-map-marker-alt"></i> 301 Menaul Blvd NE, Albuquerque</span>
					<a href={`${base}#programs`} class="btn-wide-link">Explore Programs & Pricing <i class="fas fa-arrow-right"></i></a>
				</div>
			</div>
		</div>

	</div>
</section>

<!-- ========================================================
     FIRST FALL CUP POPUP MODAL
     ======================================================== -->
<div id="fallCupModal" class="tournament-modal-overlay" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="fallCupModalTitle">
	<div class="tournament-modal-container fall-cup-modal-container">
		
		<!-- Close Button -->
		<button class="close-tournament-modal" id="closeFallCupModalBtn" aria-label="Close tournament details">&times;</button>
		
		<!-- Modal Header -->
		<div class="t-modal-header header-autumn">
			<div class="t-kicker kicker-fall"><i class="fas fa-trophy"></i> Duke City Home Tournament</div>
			<h2 id="fallCupModalTitle">First Fall Cup 2026</h2>
			<div class="t-meta-row">
				<span><i class="fas fa-calendar-alt"></i> Saturday, October 3, 2026</span>
				<span class="t-meta-divider">•</span>
				<span><i class="fas fa-map-marker-alt"></i> Menaul Fencing Gym • Albuquerque, NM</span>
				<span class="t-meta-divider">•</span>
				<span><i class="fas fa-shield-alt"></i> Hosted by Duke City Fencing Club</span>
			</div>
		</div>

		<!-- Direct Registration Callout Box -->
		<div class="t-register-callout">
			<div class="t-register-callout-text">
				<h3><i class="fas fa-ticket-alt"></i> Official Registration is Open</h3>
				<p>Secure your spot on AskFRED before the tournament closes. Fencers must register in advance.</p>
			</div>
			<a 
				href="https://www.askfred.net/tournaments/7467479b-79eb-4e27-9dfb-c34e9fc521a0" 
				target="_blank" 
				rel="noopener noreferrer" 
				class="btn-register-hero"
			>
				<i class="fas fa-external-link-alt"></i> Register on AskFRED
			</a>
		</div>

		<!-- Events & Schedule Grid -->
		<div class="t-results-box">
			<h3 class="t-box-title"><i class="fas fa-clock"></i> Events & Schedule</h3>
			
			<div class="t-events-grid">
				
				<!-- Event 1: Junior Mixed Epee -->
				<div class="t-event-card">
					<div class="t-event-header">
						<span class="t-event-time-badge"><i class="fas fa-clock"></i> 8:00 AM</span>
						<span class="t-event-badge-sub">Junior</span>
					</div>
					<h4 class="t-event-name">Junior Mixed Epee</h4>
					<div class="t-event-fee">
						<span class="fee-label">Event Fee:</span> <strong>$20</strong> <span class="fee-sub">(+$20 Reg)</span>
					</div>
				</div>

				<!-- Event 2: Y10 Mixed Epee -->
				<div class="t-event-card">
					<div class="t-event-header">
						<span class="t-event-time-badge"><i class="fas fa-clock"></i> 10:00 AM</span>
						<span class="t-event-badge-sub">Youth 10</span>
					</div>
					<h4 class="t-event-name">Y10 Mixed Epee</h4>
					<div class="t-event-fee">
						<span class="fee-label">Event Fee:</span> <strong>$20</strong> <span class="fee-sub">(+$20 Reg)</span>
					</div>
				</div>

				<!-- Event 3: Senior Open Mixed Epee -->
				<div class="t-event-card highlight-event">
					<div class="t-event-header">
						<span class="t-event-time-badge gold-time"><i class="fas fa-clock"></i> 11:30 AM</span>
						<span class="t-event-badge-sub gold-sub">Senior Open</span>
					</div>
					<h4 class="t-event-name">Senior Open Mixed Epee</h4>
					<div class="t-event-fee">
						<span class="fee-label">Event Fee:</span> <strong>$25</strong> <span class="fee-sub">(+$20 Reg)</span>
					</div>
				</div>

				<!-- Event 4: Y14 Mixed Epee -->
				<div class="t-event-card">
					<div class="t-event-header">
						<span class="t-event-time-badge"><i class="fas fa-clock"></i> 2:00 PM</span>
						<span class="t-event-badge-sub">Youth 14</span>
					</div>
					<h4 class="t-event-name">Y14 Mixed Epee</h4>
					<div class="t-event-fee">
						<span class="fee-label">Event Fee:</span> <strong>$20</strong> <span class="fee-sub">(+$20 Reg)</span>
					</div>
				</div>

			</div>
		</div>

		<!-- Pricing & Location Details Cards -->
		<div class="t-details-split-grid">
			
			<div class="t-detail-box">
				<h4 class="t-detail-title"><i class="fas fa-dollar-sign"></i> Payment Details</h4>
				<ul class="t-detail-list">
					<li><strong>Registration Fee:</strong> $20 to Register (required per fencer)</li>
					<li><strong>Junior Event Fee:</strong> $20</li>
					<li><strong>Y10 Event Fee:</strong> $20</li>
					<li><strong>Senior Open Event Fee:</strong> $25</li>
					<li><strong>Y14 Event Fee:</strong> $20</li>
				</ul>
			</div>

			<div class="t-detail-box">
				<h4 class="t-detail-title"><i class="fas fa-map-marked-alt"></i> Location & Venue</h4>
				<ul class="t-detail-list">
					<li><strong>Venue:</strong> Menaul Fencing Gym</li>
					<li><strong>Address:</strong> 301 Menaul Blvd NE, Albuquerque, NM 87107</li>
					<li><strong>Website:</strong> www.dukecityfencing.net</li>
					<li><strong>Email:</strong> info@dukecityfencing.net</li>
					<li><strong>Instagram:</strong> @dukecityfencing</li>
				</ul>
			</div>

		</div>

		<!-- Official Tournament Flyer Display -->
		<div class="t-gallery-section">
			<h3 class="t-box-title"><i class="fas fa-image"></i> Official Tournament Flyer</h3>
			
			<figure class="t-photo-item">
				<div class="t-photo-header">
					<h4>Official First Fall Cup Tournament Flyer</h4>
				</div>
				<div class="t-img-frame flyer-img-frame">
					<img 
						src={`${base}first-fall-cup-flyer.jpg`} 
						alt="Duke City Fencing Presents First Fall Cup Official Tournament Flyer" 
						class="t-full-img t-flyer-img" 
						loading="lazy" 
					/>
				</div>
				<figcaption class="t-photo-caption">
					<i class="fas fa-info-circle"></i> Official First Fall Cup tournament flyer. Scan the QR code on the flyer or click the registration button below to register on AskFRED.
				</figcaption>
			</figure>
		</div>

		<!-- Modal Footer Actions -->
		<div class="t-modal-footer dual-footer-actions">
			<a 
				href="https://www.askfred.net/tournaments/7467479b-79eb-4e27-9dfb-c34e9fc521a0" 
				target="_blank" 
				rel="noopener noreferrer" 
				class="btn-register-footer"
			>
				<i class="fas fa-external-link-alt"></i> Register on AskFRED
			</a>
			<button class="btn-close-modal-bottom" id="closeFallCupModalBottomBtn" type="button">
				<i class="fas fa-times"></i> Close Window
			</button>
		</div>

	</div>
</div>

<!-- ========================================================
     TOURNAMENT RECAP FULL-SCREEN / POPUP MODAL (AIR FORCE ROC)
     ======================================================== -->
<div id="tournamentModal" class="tournament-modal-overlay" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="tournamentModalTitle">
	<div class="tournament-modal-container">
		
		<!-- Close Button -->
		<button class="close-tournament-modal" id="closeTournamentModalBtn" aria-label="Close tournament recap">&times;</button>
		
		<!-- Modal Header -->
		<div class="t-modal-header">
			<div class="t-kicker"><i class="fas fa-trophy"></i> Official Tournament Recap</div>
			<h2 id="tournamentModalTitle">Air Force ROC & RJCC</h2>
			<div class="t-meta-row">
				<span><i class="fas fa-map-marker-alt"></i> US Air Force Academy • Colorado Springs, CO</span>
				<span class="t-meta-divider">•</span>
				<span><i class="fas fa-star"></i> C26 Ratings Earned</span>
			</div>
		</div>

		<!-- Results Breakdown Box -->
		<div class="t-results-box">
			<h3 class="t-box-title"><i class="fas fa-medal"></i> Athlete Results & Highlights</h3>
			
			<div class="t-athletes-grid">
				
				<!-- Zoe's Results -->
				<div class="t-athlete-card">
					<div class="t-athlete-top">
						<div class="t-avatar-icon"><i class="fas fa-award"></i></div>
						<div>
							<h4 class="t-athlete-name">Zoe</h4>
							<span class="t-rating-chip"><i class="fas fa-certificate"></i> Earned C26 Rating</span>
						</div>
					</div>
					<ul class="t-events-list">
						<li>
							<span class="t-chip-bronze"><i class="fas fa-medal"></i> 3rd Place</span>
							<span class="t-event-title">Cadet Women’s Epee</span>
						</li>
						<li>
							<span class="t-chip-bronze"><i class="fas fa-medal"></i> 3rd Place</span>
							<span class="t-event-title">Division II Women’s Epee</span>
						</li>
						<li>
							<span class="t-chip-top8"><i class="fas fa-award"></i> 7th Place</span>
							<span class="t-event-title">Junior Women’s Epee</span>
						</li>
					</ul>
				</div>

				<!-- Mark Kramer's Results -->
				<div class="t-athlete-card">
					<div class="t-athlete-top">
						<div class="t-avatar-icon"><i class="fas fa-award"></i></div>
						<div>
							<h4 class="t-athlete-name">Mark Kramer</h4>
							<span class="t-rating-chip"><i class="fas fa-certificate"></i> Earned C26 Rating</span>
						</div>
					</div>
					<ul class="t-events-list">
						<li>
							<span class="t-chip-bronze"><i class="fas fa-medal"></i> 3rd Place (Tie)</span>
							<span class="t-event-title">Veteran Men’s Epee</span>
						</li>
					</ul>
				</div>

			</div>
		</div>

		<!-- Full-Size Photos Gallery (In Exact Sequence Requested) -->
		<div class="t-gallery-section">
			<h3 class="t-box-title"><i class="fas fa-camera"></i> Full-Size Photo Gallery</h3>
			<p class="t-gallery-subtitle">Photos from the competition floor, medal podiums, and coaching team:</p>

			<div class="t-photos-vertical-stack">
				
				<!-- Zoe with Medals -->
				<figure class="t-photo-item">
					<div class="t-photo-header">
						<h4>Zoe — Triple Medalist & C26 Rating</h4>
					</div>
					<div class="t-img-frame">
						<img 
							src={`${base}tournament-zoe-medals.jpg`} 
							alt="Zoe with 3 medals at the Air Force ROC & RJCC" 
							class="t-full-img" 
							loading="lazy" 
						/>
					</div>
					<figcaption class="t-photo-caption">
						<i class="fas fa-info-circle"></i> Zoe celebrating her 3-medal performance (Cadet, Div II, Junior) and earning her C26 rating.
					</figcaption>
				</figure>

				<!-- Podium Ceremony 1 -->
				<figure class="t-photo-item">
					<div class="t-photo-header">
						<h4>Podium Ceremony — Cadet & Division II Women's Epee</h4>
					</div>
					<div class="t-img-frame">
						<img 
							src={`${base}tournament-zoe-podium-1.jpg`} 
							alt="Zoe on the Medal Podium at Air Force Academy" 
							class="t-full-img" 
							loading="lazy" 
						/>
					</div>
					<figcaption class="t-photo-caption">
						<i class="fas fa-info-circle"></i> Zoe on the medal podium step at the United States Air Force Academy in Colorado.
					</figcaption>
				</figure>

				<!-- Podium Ceremony 2 -->
				<figure class="t-photo-item">
					<div class="t-photo-header">
						<h4>Podium Ceremony — Junior Women's Epee</h4>
					</div>
					<div class="t-img-frame">
						<img 
							src={`${base}tournament-zoe-podium-2.jpg`} 
							alt="Zoe on the Junior Medal Podium at Air Force Academy" 
							class="t-full-img" 
							loading="lazy" 
						/>
					</div>
					<figcaption class="t-photo-caption">
						<i class="fas fa-info-circle"></i> Zoe on the medal podium for Junior Women's Epee at the Air Force RJCC.
					</figcaption>
				</figure>

				<!-- Zoe with Coaches Courtney & Bella -->
				<figure class="t-photo-item">
					<div class="t-photo-header">
						<h4>Team & Coaching Staff</h4>
					</div>
					<div class="t-img-frame">
						<img 
							src={`${base}tournament-zoe-coaches.jpg`} 
							alt="Zoe with Head Coach Courtney Hurley and Coach Bella" 
							class="t-full-img" 
							loading="lazy" 
						/>
					</div>
					<figcaption class="t-photo-caption">
						<i class="fas fa-info-circle"></i> Zoe with Head Coach Courtney Hurley (3-Time Olympian & Bronze Medalist) and Coach Bella at the tournament venue.
					</figcaption>
				</figure>

				<!-- Mark Kramer Official Results List -->
				<figure class="t-photo-item">
					<div class="t-photo-header">
						<h4>Official Results — Mark Kramer (3rd Place Veteran Men's Epee)</h4>
					</div>
					<div class="t-img-frame results-table-frame">
						<img 
							src={`${base}tournament-mark-results.jpg`} 
							alt="Mark Kramer 3rd Place Veteran Men's Epee official results sheet" 
							class="t-full-img results-sheet-img" 
							loading="lazy" 
						/>
					</div>
					<figcaption class="t-photo-caption">
						<i class="fas fa-info-circle"></i> Official tournament standings: Mark Kramer tying for 3rd Place in Veteran Men's Epee and earning his C26 rating.
					</figcaption>
				</figure>

			</div>
		</div>

		<!-- Modal Footer Close -->
		<div class="t-modal-footer">
			<button class="btn-close-modal-bottom" id="closeTournamentModalBottomBtn" type="button">
				<i class="fas fa-times"></i> Close Recap Window
			</button>
		</div>

	</div>
</div>

<style>
	.news-section {
		padding: var(--section-padding);
		background: linear-gradient(180deg, #091a13 0%, #040e0a 100%);
		color: var(--text-light);
		position: relative;
	}

	.news-container {
		max-width: 1240px;
		margin: 0 auto;
	}

	.news-header {
		text-align: center;
		max-width: 760px;
		margin: 0 auto 3.5rem;
	}

	.news-kicker {
		display: inline-block;
