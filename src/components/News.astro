	.t-athletes-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1.25rem;
	}

	.t-athlete-card {
		background: rgba(0, 0, 0, 0.35);
		border: 1px solid rgba(212, 175, 55, 0.25);
		border-radius: 10px;
		padding: 1.25rem;
	}

	.t-athlete-top {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin-bottom: 0.85rem;
	}

	.t-avatar-icon {
		width: 38px;
		height: 38px;
		border-radius: 8px;
		background: rgba(212, 175, 55, 0.2);
		color: var(--gold);
		border: 1px solid var(--gold);
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 1.1rem;
	}

	.t-athlete-name {
		font-size: 1.25rem;
		color: #fff;
		margin: 0 0 0.15rem 0;
		font-weight: 800;
