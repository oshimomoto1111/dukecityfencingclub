---
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;

const tournamentPhotos = [
	{
		src: `${base}tournament-zoe-medals.jpg`,
		alt: "Zoe with 3 medals at the Air Force ROC & RJCC",
		title: "Zoe with 3 Medals",
		caption: "Zoe celebrating her triple-medal finish (Cadet, Div II, Junior) and earning her C26 rating!",
		tag: "Triple Medalist"
	},
	{
		src: `${base}tournament-zoe-podium-1.jpg`,
		alt: "Zoe on the Medal Podium (Cadet & Div II) at US Air Force Academy",
		title: "Podium Ceremony — Cadet & Div II",
		caption: "Zoe on the medal podium at the United States Air Force Academy in Colorado.",
		tag: "Podium Finish"
	},
	{
		src: `${base}tournament-zoe-podium-2.jpg`,
		alt: "Zoe on the Junior Medal Podium at US Air Force Academy",
		title: "Podium Ceremony — Junior Women's Epee",
		caption: "Zoe on the medal podium for Junior Women's Epee at the Air Force RJCC.",
		tag: "Podium Finish"
	},
	{
		src: `${base}tournament-zoe-coaches.jpg`,
		alt: "Zoe with Head Coach Courtney Hurley and Coach Bella",
		title: "With Coaches Courtney & Bella",
		caption: "Zoe with Head Coach Courtney Hurley (Olympic Medalist) & Coach Bella at the tournament venue.",
		tag: "Team & Coaching"
	},
	{
		src: `${base}tournament-mark-results.jpg`,
		alt: "Mark Kramer 3rd Place Veteran Men's Epee official results",
		title: "Mark Kramer Official Results",
		caption: "Mark Kramer securing 3rd Place (Tie) in Veteran Men's Epee and earning his C26 rating.",
		tag: "Vet Epee Results"
	},
];
---

<section class="news-section" id="news">
	<div class="news-container">
		
		<div class="news-header">
			<span class="news-kicker">Latest From The Strip</span>
			<h2 class="section-title-custom">News, Events & Tournament Results</h2>
			<p class="news-subtitle">
				Follow our competitive results, upcoming camps, and club notices as our fencers compete locally and nationally.
			</p>
		</div>

		<!-- Bento Grid -->
		<div class="bento-grid">
			
			<!-- Card 1: Featured Tournament Results Teaser (Opens Pop-up Modal) -->
			<article class="bento-card bento-card-featured">
				<div class="card-glow-bg"></div>
				
				<div class="featured-card-layout">
					<!-- Preview Image with Badge -->
					<div class="featured-img-preview" style={`background-image: url('${base}tournament-zoe-medals.jpg');`}>
						<div class="img-preview-overlay"></div>
						<div class="preview-badge-row">
							<span class="news-tag tag-achievement"><i class="fas fa-trophy"></i> Tournament Results</span>
							<span class="photo-count-pill"><i class="fas fa-camera"></i> 5 Photos</span>
						</div>
						<div class="preview-cta-prompt">
							<span><i class="fas fa-expand-alt"></i> Click to Open Full Recap</span>
						</div>
					</div>

					<!-- Content Preview -->
					<div class="bento-card-inner">
						<div class="tag-row">
							<span class="location-pill"><i class="fas fa-map-marker-alt"></i> Colorado Springs, CO</span>
							<span class="status-pill"><i class="fas fa-circle-dot"></i> Air Force ROC & RJCC</span>
						</div>

						<div class="bento-card-body">
							<h3 class="bento-title">Air Force ROC & RJCC: Triple Medals & C26 Ratings!</h3>
							<p class="bento-desc">
								Huge congratulations to <strong>Zoe</strong> (3rd Cadet, 3rd Div II, 7th Junior) and <strong>Mark Kramer</strong> (3rd Vet Men’s Epee) for earning their <strong>C26 ratings</strong> in Colorado!
							</p>

							<!-- Mini Badges List -->
							<div class="mini-achievements-list">
								<span class="mini-chip">🥉 Zoe: 3rd Cadet Women’s Epee</span>
								<span class="mini-chip">🥉 Zoe: 3rd Div II Women’s Epee</span>
								<span class="mini-chip">🎖️ Zoe: 7th Junior Women’s Epee</span>
								<span class="mini-chip">🥉 Mark Kramer: 3rd Vet Men’s Epee</span>
								<span class="mini-chip gold-chip">⭐ Both Earned C26 Ratings</span>
							</div>
						</div>

						<div class="bento-card-footer">
							<button class="btn-open-tournament-modal" id="openTournamentModalBtn" type="button">
								<span>View Full Recap & Photo Gallery</span> <i class="fas fa-arrow-right"></i>
							</button>
						</div>
					</div>
				</div>
			</article>

			<!-- Side Column: Events & Notices -->
			<div class="bento-side">
				
				<!-- Card 2: Upcoming Events & Clinics -->
				<div class="bento-card bento-card-small">
					<div class="card-glow-bg"></div>
					<div class="bento-card-inner">
						<div class="tag-row">
							<span class="news-tag tag-event"><i class="fas fa-calendar-alt"></i> Upcoming Events</span>
							<span class="status-pill"><i class="fas fa-clock"></i> Fall 2026</span>
						</div>

						<div class="bento-card-body">
							<h4 class="bento-title-small">Camps, Clinics & Workshops</h4>
							<p class="bento-desc-small">
								Intensive seasonal training camps, referee seminars, and guest master clinics will be announced here with online registration links.
							</p>
						</div>

						<div class="bento-card-footer">
							<span class="placeholder-notice"><i class="fas fa-info-circle"></i> Dates to be announced</span>
						</div>
					</div>
				</div>

				<!-- Card 3: Club Announcements -->
				<div class="bento-card bento-card-small">
					<div class="card-glow-bg"></div>
					<div class="bento-card-inner">
						<div class="tag-row">
							<span class="news-tag tag-announcement"><i class="fas fa-bullhorn"></i> Club Notice</span>
							<span class="status-pill"><i class="fas fa-check-circle"></i> Active</span>
						</div>

						<div class="bento-card-body">
							<h4 class="bento-title-small">Saturday Tournaments & Open Hours</h4>
							<p class="bento-desc-small">
								Saturday club tournaments run every non-travel weekend from 11:00 AM – 2:00 PM at our Menaul School gym.
							</p>
						</div>

						<div class="bento-card-footer">
							<span class="placeholder-notice"><i class="fas fa-map-marker-alt"></i> 301 Menaul Blvd NE</span>
						</div>
					</div>
				</div>

			</div>

		</div>

	</div>
</section>

<!-- ========================================================
     TOURNAMENT RECAP FULL-SCREEN / POPUP MODAL
     ======================================================== -->
<div id="tournamentModal" class="tournament-modal-overlay" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="tournamentModalTitle">
	<div class="tournament-modal-container">
		
		<!-- Close Button -->
		<button class="close-tournament-modal" id="closeTournamentModalBtn" aria-label="Close tournament recap">&times;</button>
		
		<!-- Modal Header -->
		<div class="t-modal-header">
			<div class="t-kicker"><i class="fas fa-trophy"></i> Official Tournament Recap</div>
			<h2 id="tournamentModalTitle">Air Force ROC & RJCC</h2>
			<div class="t-meta-row">
				<span><i class="fas fa-map-marker-alt"></i> US Air Force Academy • Colorado Springs, CO</span>
				<span class="t-meta-divider">•</span>
				<span><i class="fas fa-star"></i> C26 Ratings Earned</span>
			</div>
		</div>

		<!-- Results Breakdown Box -->
		<div class="t-results-box">
			<h3 class="t-box-title"><i class="fas fa-medal"></i> Athlete Results & Highlights</h3>
			
			<div class="t-athletes-grid">
				
				<!-- Zoe's Results -->
				<div class="t-athlete-card">
					<div class="t-athlete-top">
						<div class="t-avatar-icon"><i class="fas fa-award"></i></div>
						<div>
							<h4 class="t-athlete-name">Zoe</h4>
							<span class="t-rating-chip"><i class="fas fa-certificate"></i> Earned C26 Rating</span>
						</div>
					</div>
					<ul class="t-events-list">
						<li>
							<span class="t-chip-bronze"><i class="fas fa-medal"></i> 3rd Place</span>
							<span class="t-event-title">Cadet Women’s Epee</span>
						</li>
						<li>
							<span class="t-chip-bronze"><i class="fas fa-medal"></i> 3rd Place</span>
							<span class="t-event-title">Division II Women’s Epee</span>
						</li>
						<li>
							<span class="t-chip-top8"><i class="fas fa-award"></i> 7th Place</span>
							<span class="t-event-title">Junior Women’s Epee</span>
						</li>
					</ul>
				</div>

				<!-- Mark Kramer's Results -->
				<div class="t-athlete-card">
					<div class="t-athlete-top">
						<div class="t-avatar-icon"><i class="fas fa-award"></i></div>
						<div>
							<h4 class="t-athlete-name">Mark Kramer</h4>
							<span class="t-rating-chip"><i class="fas fa-certificate"></i> Earned C26 Rating</span>
						</div>
					</div>
					<ul class="t-events-list">
						<li>
							<span class="t-chip-bronze"><i class="fas fa-medal"></i> 3rd Place (Tie)</span>
							<span class="t-event-title">Veteran Men’s Epee</span>
						</li>
					</ul>
				</div>

			</div>
		</div>

		<!-- Full-Size Photos Gallery (In Exact Sequence Requested) -->
		<div class="t-gallery-section">
			<h3 class="t-box-title"><i class="fas fa-camera"></i> Full-Size Photo Gallery</h3>
			<p class="t-gallery-subtitle">Photos from the competition floor, medal podiums, and coaching team:</p>

			<div class="t-photos-vertical-stack">
				
				<!-- 1. Zoe with Medals -->
				<figure class="t-photo-item">
					<div class="t-photo-header">
						<h4>Zoe — Triple Medalist & C26 Rating</h4>
					</div>
					<div class="t-img-frame">
						<img 
							src={`${base}tournament-zoe-medals.jpg`} 
							alt="Zoe with 3 medals at the Air Force ROC & RJCC" 
							class="t-full-img" 
							loading="lazy" 
						/>
					</div>
					<figcaption class="t-photo-caption">
						<i class="fas fa-info-circle"></i> Zoe celebrating her 3-medal performance (Cadet, Div II, Junior) and earning her C26 rating.
					</figcaption>
				</figure>

				<!-- 2. Podium Ceremony 1 -->
				<figure class="t-photo-item">
					<div class="t-photo-header">
						<h4>Podium Ceremony — Cadet & Division II Women's Epee</h4>
					</div>
					<div class="t-img-frame">
						<img 
							src={`${base}tournament-zoe-podium-1.jpg`} 
							alt="Zoe on the Medal Podium at Air Force Academy" 
							class="t-full-img" 
							loading="lazy" 
						/>
					</div>
					<figcaption class="t-photo-caption">
						<i class="fas fa-info-circle"></i> Zoe on the medal podium step at the United States Air Force Academy in Colorado.
					</figcaption>
				</figure>

				<!-- 3. Podium Ceremony 2 -->
				<figure class="t-photo-item">
					<div class="t-photo-header">
						<h4>Podium Ceremony — Junior Women's Epee</h4>
					</div>
					<div class="t-img-frame">
						<img 
							src={`${base}tournament-zoe-podium-2.jpg`} 
							alt="Zoe on the Junior Medal Podium at Air Force Academy" 
							class="t-full-img" 
							loading="lazy" 
						/>
					</div>
					<figcaption class="t-photo-caption">
						<i class="fas fa-info-circle"></i> Zoe on the medal podium for Junior Women's Epee at the Air Force RJCC.
					</figcaption>
				</figure>

				<!-- 4. Zoe with Coaches Courtney & Bella -->
				<figure class="t-photo-item">
					<div class="t-photo-header">
						<h4>Team & Coaching Staff</h4>
					</div>
					<div class="t-img-frame">
						<img 
							src={`${base}tournament-zoe-coaches.jpg`} 
							alt="Zoe with Head Coach Courtney Hurley and Coach Bella" 
							class="t-full-img" 
							loading="lazy" 
						/>
					</div>
					<figcaption class="t-photo-caption">
						<i class="fas fa-info-circle"></i> Zoe with Head Coach Courtney Hurley (3-Time Olympian & Bronze Medalist) and Coach Bella at the tournament venue.
					</figcaption>
				</figure>

				<!-- 5. Mark Kramer Official Results List -->
				<figure class="t-photo-item">
					<div class="t-photo-header">
						<h4>Official Results — Mark Kramer (3rd Place Veteran Men's Epee)</h4>
					</div>
					<div class="t-img-frame results-table-frame">
						<img 
							src={`${base}tournament-mark-results.jpg`} 
							alt="Mark Kramer 3rd Place Veteran Men's Epee official results sheet" 
							class="t-full-img results-sheet-img" 
							loading="lazy" 
						/>
					</div>
					<figcaption class="t-photo-caption">
						<i class="fas fa-info-circle"></i> Official tournament standings: Mark Kramer tying for 3rd Place in Veteran Men's Epee and earning his C26 rating.
					</figcaption>
				</figure>

			</div>
		</div>

		<!-- Modal Footer Close -->
		<div class="t-modal-footer">
			<button class="btn-close-modal-bottom" id="closeTournamentModalBottomBtn" type="button">
				<i class="fas fa-times"></i> Close Recap Window
			</button>
		</div>

	</div>
</div>

<style>
	.news-section {
		padding: var(--section-padding);
		background: linear-gradient(180deg, #091a13 0%, #040e0a 100%);
		color: var(--text-light);
		position: relative;
	}

	.news-container {
		max-width: 1240px;
		margin: 0 auto;
	}

	.news-header {
		text-align: center;
		max-width: 760px;
		margin: 0 auto 3.5rem;
	}

	.news-kicker {
		display: inline-block;
		color: var(--gold);
		font-weight: 800;
		font-size: 0.85rem;
		text-transform: uppercase;
		letter-spacing: 2px;
		margin-bottom: 0.5rem;
	}

	.section-title-custom {
		font-size: 2.5rem;
		color: var(--bg-cream);
		margin-bottom: 0.85rem;
		font-family: var(--font-headings);
		font-weight: 800;
		line-height: 1.15;
	}

	.news-subtitle {
		font-size: 1.05rem;
		opacity: 0.85;
		line-height: 1.6;
		color: #e0e0e0;
	}

	/* Bento Grid Layout */
	.bento-grid {
		display: grid;
		grid-template-columns: 1.25fr 0.75fr;
		gap: 2rem;
		margin-bottom: 2.5rem;
	}

	.bento-side {
		display: flex;
		flex-direction: column;
		gap: 2rem;
	}

	/* Bento Card Styling */
	.bento-card {
		background: rgba(255, 255, 255, 0.03);
		border: 1px solid rgba(255, 255, 255, 0.1);
		border-radius: 16px;
		position: relative;
		overflow: hidden;
		transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
		display: flex;
		flex-direction: column;
	}

	.bento-card:hover {
		transform: translateY(-3px);
		border-color: rgba(212, 175, 55, 0.4);
		box-shadow: 0 12px 30px rgba(0, 0, 0, 0.4);
	}

	.bento-card-featured {
		min-height: 440px;
		border: 1px solid rgba(212, 175, 55, 0.35);
		background: linear-gradient(145deg, rgba(0, 59, 43, 0.35) 0%, rgba(0, 0, 0, 0.45) 100%);
	}

	.featured-card-layout {
		display: flex;
		flex-direction: column;
		height: 100%;
	}

	.featured-img-preview {
		height: 220px;
		background-size: cover;
		background-position: center 20%;
		position: relative;
		cursor: pointer;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		padding: 1rem 1.25rem;
		border-bottom: 2px solid rgba(212, 175, 55, 0.3);
	}

	.img-preview-overlay {
		position: absolute;
		inset: 0;
		background: linear-gradient(180deg, rgba(0, 0, 0, 0.3) 0%, rgba(0, 0, 0, 0.75) 100%);
		transition: background 0.3s ease;
	}

	.featured-img-preview:hover .img-preview-overlay {
		background: linear-gradient(180deg, rgba(0, 0, 0, 0.2) 0%, rgba(0, 0, 0, 0.6) 100%);
	}

	.preview-badge-row {
		position: relative;
		z-index: 2;
		display: flex;
		justify-content: space-between;
		align-items: center;
	}

	.photo-count-pill {
		background: rgba(0, 0, 0, 0.7);
		color: #fff;
		font-size: 0.75rem;
		font-weight: 700;
		padding: 0.25rem 0.65rem;
		border-radius: 50px;
		border: 1px solid rgba(255, 255, 255, 0.3);
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
	}

	.preview-cta-prompt {
		position: relative;
		z-index: 2;
		align-self: flex-start;
		background: rgba(212, 175, 55, 0.9);
		color: #000;
		font-size: 0.8rem;
		font-weight: 800;
		padding: 0.35rem 0.85rem;
		border-radius: 6px;
		letter-spacing: 0.5px;
	}

	.bento-card-small {
		flex: 1;
		min-height: 205px;
	}

	.bento-card-inner {
		padding: 1.75rem;
		display: flex;
		flex-direction: column;
		height: 100%;
		position: relative;
		z-index: 2;
	}

	.tag-row {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 1rem;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.news-tag {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font-size: 0.75rem;
		font-weight: 800;
		text-transform: uppercase;
		padding: 0.35rem 0.85rem;
		border-radius: 50px;
		letter-spacing: 0.5px;
	}

	.tag-achievement {
		background: rgba(226, 10, 23, 0.2);
		color: #ff6b6b;
		border: 1px solid rgba(226, 10, 23, 0.5);
	}

	.tag-event {
		background: rgba(212, 175, 55, 0.15);
		color: var(--gold);
		border: 1px solid rgba(212, 175, 55, 0.4);
	}

	.tag-announcement {
		background: rgba(0, 59, 43, 0.6);
		color: #a3e6cd;
		border: 1px solid rgba(0, 59, 43, 0.9);
	}

	.location-pill {
		font-size: 0.78rem;
		color: var(--gold);
		font-weight: 600;
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
	}

	.status-pill {
		font-size: 0.75rem;
		color: rgba(255, 255, 255, 0.65);
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
	}

	.status-pill i {
		color: var(--gold);
		font-size: 0.55rem;
	}

	.bento-card-body {
		flex-grow: 1;
		margin-bottom: 1.25rem;
	}

	.bento-title {
		font-size: 1.45rem;
		color: var(--bg-cream);
		margin-bottom: 0.65rem;
		font-family: var(--font-headings);
		font-weight: 800;
		line-height: 1.25;
	}

	.bento-title-small {
		font-size: 1.25rem;
		color: var(--bg-cream);
		margin-bottom: 0.5rem;
		font-family: var(--font-headings);
		font-weight: 800;
	}

	.bento-desc {
		font-size: 0.92rem;
		color: #ccc;
		line-height: 1.55;
		margin-bottom: 1rem;
	}

	.bento-desc-small {
		font-size: 0.88rem;
		color: #bbb;
		line-height: 1.5;
	}

	.mini-achievements-list {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}

	.mini-chip {
		font-size: 0.75rem;
		font-weight: 600;
		background: rgba(255, 255, 255, 0.08);
		border: 1px solid rgba(255, 255, 255, 0.15);
		color: #eee;
		padding: 0.2rem 0.6rem;
		border-radius: 4px;
	}

	.mini-chip.gold-chip {
		background: rgba(212, 175, 55, 0.2);
		border-color: var(--gold);
		color: var(--gold);
		font-weight: 800;
	}

	.bento-card-footer {
		margin-top: auto;
		padding-top: 1rem;
		border-top: 1px solid rgba(255, 255, 255, 0.08);
	}

	.btn-open-tournament-modal {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.6rem;
		width: 100%;
		background: var(--accent-red);
		color: #fff;
		padding: 0.85rem 1.25rem;
		border-radius: var(--border-radius);
		font-family: var(--font-headings);
		font-weight: 800;
		font-size: 0.9rem;
		text-transform: uppercase;
		letter-spacing: 0.5px;
		border: none;
		cursor: pointer;
		transition: background 0.3s, transform 0.2s, box-shadow 0.3s;
		box-shadow: 0 4px 15px rgba(226, 10, 23, 0.4);
	}

	.btn-open-tournament-modal:hover {
		background: var(--accent-red-hover);
		transform: translateY(-2px);
		box-shadow: 0 6px 20px rgba(226, 10, 23, 0.6);
	}

	.placeholder-notice {
		font-size: 0.8rem;
		color: rgba(255, 255, 255, 0.6);
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
	}

	.placeholder-notice i {
		color: var(--gold);
	}

	/* ========================================================
	   TOURNAMENT RECAP FULL-SCREEN MODAL STYLING
	   ======================================================== */
	.tournament-modal-overlay {
		position: fixed;
		inset: 0;
		background: rgba(0, 0, 0, 0.88);
		backdrop-filter: blur(10px);
		display: none;
		justify-content: center;
		align-items: center;
		z-index: 10000;
		padding: 1.5rem;
	}

	.tournament-modal-overlay.active {
		display: flex;
	}

	.tournament-modal-container {
		background: #0d1e16;
		color: var(--text-light);
