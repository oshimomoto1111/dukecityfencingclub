		color: #fff;
		font-size: 0.75rem;
		font-weight: 700;
		padding: 0.25rem 0.65rem;
		border-radius: 50px;
		border: 1px solid rgba(255, 255, 255, 0.3);
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
	}

	.date-badge-pill {
		border-color: rgba(245, 158, 11, 0.6);
		color: #fde68a;
		background: rgba(30, 20, 10, 0.8);
	}

	.preview-cta-prompt {
		position: relative;
		z-index: 2;
		align-self: flex-start;
		background: rgba(212, 175, 55, 0.9);
		color: #000;
		font-size: 0.8rem;
		font-weight: 800;
		padding: 0.35rem 0.85rem;
		border-radius: 6px;
		letter-spacing: 0.5px;
	}

	.prompt-gold {
		background: linear-gradient(135deg, #d4af37, #f59e0b);
	}

	.bento-card-inner {
		padding: 1.75rem;
		display: flex;
		flex-direction: column;
		flex-grow: 1;
		position: relative;
		z-index: 2;
	}

	.tag-row {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 0.85rem;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.news-tag {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font-size: 0.75rem;
		font-weight: 800;
		text-transform: uppercase;
		padding: 0.35rem 0.85rem;
		border-radius: 50px;
		letter-spacing: 0.5px;
	}

	.tag-fall-cup {
		background: rgba(226, 110, 23, 0.25);
		color: #fbb775;
		border: 1px solid rgba(226, 110, 23, 0.6);
	}

	.tag-achievement {
		background: rgba(226, 10, 23, 0.2);
		color: #ff6b6b;
		border: 1px solid rgba(226, 10, 23, 0.5);
	}

	.tag-announcement {
		background: rgba(0, 59, 43, 0.6);
		color: #a3e6cd;
		border: 1px solid rgba(0, 59, 43, 0.9);
	}

	.location-pill {
		font-size: 0.78rem;
		color: var(--gold);
		font-weight: 600;
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
	}

	.status-pill {
		font-size: 0.75rem;
		color: rgba(255, 255, 255, 0.65);
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
	}

	.status-pill i {
		color: var(--gold);
		font-size: 0.55rem;
	}

	.status-open {
		color: #86efac;
	}

	.status-open i {
		color: #4ade80;
		font-size: 0.7rem;
	}

	.bento-card-body {
		flex-grow: 1;
		margin-bottom: 1.25rem;
	}

	.bento-title {
		font-size: 1.45rem;
		color: var(--bg-cream);
		margin-bottom: 0.65rem;
		font-family: var(--font-headings);
		font-weight: 800;
		line-height: 1.25;
	}

	.bento-desc {
		font-size: 0.92rem;
		color: #ccc;
		line-height: 1.55;
		margin-bottom: 1rem;
	}

	.mini-achievements-list {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}

	.mini-chip {
		font-size: 0.75rem;
		font-weight: 600;
		background: rgba(255, 255, 255, 0.08);
		border: 1px solid rgba(255, 255, 255, 0.15);
		color: #eee;
		padding: 0.2rem 0.6rem;
		border-radius: 4px;
	}

	.mini-chip.event-chip {
		background: rgba(255, 255, 255, 0.06);
		border-color: rgba(245, 158, 11, 0.3);
		color: #fef08a;
	}

	.mini-chip.gold-chip {
		background: rgba(212, 175, 55, 0.2);
		border-color: var(--gold);
		color: var(--gold);
		font-weight: 800;
	}

	.bento-card-footer {
		margin-top: auto;
		padding-top: 1rem;
		border-top: 1px solid rgba(255, 255, 255, 0.08);
	}

	.dual-action-footer {
		display: grid;
		grid-template-columns: 1.2fr 0.8fr;
		gap: 0.75rem;
	}

	.btn-askfred-direct {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		background: linear-gradient(135deg, #c0392b 0%, #e74c3c 100%);
		color: #fff;
		padding: 0.85rem 1rem;
		border-radius: var(--border-radius);
		font-family: var(--font-headings);
		font-weight: 800;
		font-size: 0.88rem;
		text-transform: uppercase;
		letter-spacing: 0.5px;
		text-decoration: none;
		transition: all 0.25s ease;
		box-shadow: 0 4px 15px rgba(231, 76, 60, 0.4);
		text-align: center;
	}

	.btn-askfred-direct:hover {
		background: linear-gradient(135deg, #a93226 0%, #c0392b 100%);
		transform: translateY(-2px);
		box-shadow: 0 6px 20px rgba(231, 76, 60, 0.6);
		color: #fff;
	}

	.btn-open-modal-secondary {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.4rem;
		background: rgba(255, 255, 255, 0.1);
		border: 1px solid rgba(212, 175, 55, 0.5);
		color: var(--gold);
		padding: 0.85rem 0.85rem;
		border-radius: var(--border-radius);
		font-family: var(--font-headings);
		font-weight: 700;
		font-size: 0.85rem;
		text-transform: uppercase;
		letter-spacing: 0.5px;
		cursor: pointer;
		transition: all 0.25s ease;
	}

	.btn-open-modal-secondary:hover {
		background: var(--gold);
		color: #000;
		transform: translateY(-2px);
	}

	.btn-open-tournament-modal {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.6rem;
		width: 100%;
		background: var(--accent-red);
		color: #fff;
		padding: 0.85rem 1.25rem;
		border-radius: var(--border-radius);
		font-family: var(--font-headings);
		font-weight: 800;
		font-size: 0.9rem;
		text-transform: uppercase;
		letter-spacing: 0.5px;
		border: none;
		cursor: pointer;
		transition: background 0.3s, transform 0.2s, box-shadow 0.3s;
		box-shadow: 0 4px 15px rgba(226, 10, 23, 0.4);
	}

	.btn-open-tournament-modal:hover {
		background: var(--accent-red-hover);
		transform: translateY(-2px);
		box-shadow: 0 6px 20px rgba(226, 10, 23, 0.6);
	}

	/* Bottom Wide Notice Banner */
	.bento-card-wide {
		border: 1px solid rgba(255, 255, 255, 0.12);
		background: linear-gradient(135deg, rgba(0, 59, 43, 0.4) 0%, rgba(13, 30, 22, 0.6) 100%);
	}

	.wide-layout {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 2rem;
		padding: 1.75rem 2rem;
	}

	.wide-info {
		flex: 1;
	}

	.wide-title {
		font-size: 1.3rem;
		color: var(--bg-cream);
		margin-bottom: 0.4rem;
		font-family: var(--font-headings);
		font-weight: 800;
	}

	.wide-desc {
		font-size: 0.92rem;
		color: #ccc;
		line-height: 1.5;
		margin: 0;
	}

	.wide-actions {
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		gap: 0.75rem;
		flex-shrink: 0;
	}

	.location-badge {
		font-size: 0.8rem;
		color: var(--gold);
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		font-weight: 600;
	}

	.btn-wide-link {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		background: rgba(255, 255, 255, 0.08);
		border: 1px solid var(--gold);
		color: var(--gold);
		padding: 0.6rem 1.15rem;
		border-radius: var(--border-radius);
		font-family: var(--font-headings);
		font-weight: 700;
		font-size: 0.82rem;
		text-transform: uppercase;
		letter-spacing: 0.5px;
		text-decoration: none;
		transition: all 0.25s ease;
	}

	.btn-wide-link:hover {
		background: var(--gold);
		color: #000;
		transform: translateY(-2px);
	}

	/* ========================================================
	   MODALS COMMON STYLING
	   ======================================================== */
	.tournament-modal-overlay {
		position: fixed;
		inset: 0;
		background: rgba(0, 0, 0, 0.88);
		backdrop-filter: blur(10px);
		display: none;
		justify-content: center;
		align-items: center;
		z-index: 10000;
		padding: 1.5rem;
	}

	.tournament-modal-overlay.active {
		display: flex;
	}

	.tournament-modal-container {
		background: #0d1e16;
		color: var(--text-light);
		border-radius: 20px;
		width: 100%;
		max-width: 820px;
		max-height: 90vh;
		overflow-y: auto;
		position: relative;
		border: 2px solid var(--gold);
		box-shadow: 0 25px 70px rgba(0, 0, 0, 0.8);
		padding: 2.75rem 2.5rem 2rem;
		animation: modalZoomIn 0.3s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.fall-cup-modal-container {
		border-color: #f59e0b;
	}

	@keyframes modalZoomIn {
		from {
			opacity: 0;
			transform: scale(0.92) translateY(20px);
		}
		to {
			opacity: 1;
			transform: scale(1) translateY(0);
		}
	}

	.close-tournament-modal {
		position: absolute;
		top: 1.25rem;
		right: 1.5rem;
		font-size: 2.4rem;
		background: none;
		border: none;
		color: #fff;
		cursor: pointer;
		line-height: 1;
		opacity: 0.7;
		transition: opacity 0.2s, color 0.2s, transform 0.2s;
	}

	.close-tournament-modal:hover {
		opacity: 1;
		color: var(--accent-red);
		transform: scale(1.1);
	}

	.t-modal-header {
		text-align: center;
		margin-bottom: 2rem;
		padding-bottom: 1.5rem;
		border-bottom: 1px solid rgba(212, 175, 55, 0.3);
	}

	.t-modal-header.header-autumn {
		border-bottom-color: rgba(245, 158, 11, 0.35);
	}

	.t-kicker {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font-size: 0.78rem;
		font-weight: 800;
		text-transform: uppercase;
		letter-spacing: 1.5px;
		color: var(--gold);
		background: rgba(212, 175, 55, 0.15);
		border: 1px solid rgba(212, 175, 55, 0.35);
		padding: 0.25rem 0.85rem;
		border-radius: 50px;
		margin-bottom: 0.65rem;
	}

	.kicker-fall {
		color: #f59e0b;
		background: rgba(245, 158, 11, 0.15);
		border-color: rgba(245, 158, 11, 0.4);
	}

	.t-modal-header h2 {
		font-size: 2.3rem;
		color: var(--bg-cream);
		font-family: var(--font-headings);
		font-weight: 800;
		margin: 0 0 0.5rem 0;
	}

	.t-meta-row {
		display: flex;
		justify-content: center;
		align-items: center;
		gap: 0.75rem;
		font-size: 0.92rem;
		color: #ccc;
		flex-wrap: wrap;
	}

	.t-meta-row i {
		color: var(--gold);
	}

	.t-meta-divider {
		color: var(--gold);
	}

	/* Fall Cup Register Callout */
	.t-register-callout {
		background: linear-gradient(135deg, rgba(245, 158, 11, 0.15) 0%, rgba(220, 38, 38, 0.2) 100%);
		border: 1.5px solid rgba(245, 158, 11, 0.5);
		border-radius: 14px;
		padding: 1.5rem 1.75rem;
		margin-bottom: 2rem;
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 1.5rem;
		flex-wrap: wrap;
	}

	.t-register-callout-text h3 {
		font-size: 1.25rem;
		color: #fde68a;
		margin: 0 0 0.25rem 0;
		font-family: var(--font-headings);
		font-weight: 800;
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.t-register-callout-text p {
		margin: 0;
		font-size: 0.9rem;
		color: #eee;
	}

	.btn-register-hero {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		background: linear-gradient(135deg, #c0392b 0%, #e74c3c 100%);
		color: #fff;
		padding: 0.85rem 1.6rem;
		border-radius: var(--border-radius);
		font-family: var(--font-headings);
		font-weight: 800;
		font-size: 0.95rem;
		text-transform: uppercase;
		letter-spacing: 0.5px;
		text-decoration: none;
		transition: all 0.25s ease;
		box-shadow: 0 4px 15px rgba(231, 76, 60, 0.5);
		white-space: nowrap;
	}

	.btn-register-hero:hover {
		background: linear-gradient(135deg, #a93226 0%, #c0392b 100%);
		transform: translateY(-2px);
		box-shadow: 0 6px 20px rgba(231, 76, 60, 0.7);
		color: #fff;
	}

	/* Results / Events Schedule Box */
	.t-results-box {
		background: rgba(255, 255, 255, 0.04);
		border: 1px solid rgba(255, 255, 255, 0.12);
		border-radius: 14px;
		padding: 1.75rem;
		margin-bottom: 2rem;
	}

	.t-box-title {
		font-size: 1.3rem;
		color: var(--gold);
		font-family: var(--font-headings);
		font-weight: 800;
		margin: 0 0 1.25rem 0;
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	/* Events Grid (Fall Cup) */
	.t-events-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1.25rem;
	}

	.t-event-card {
		background: rgba(0, 0, 0, 0.35);
		border: 1px solid rgba(245, 158, 11, 0.25);
		border-radius: 10px;
		padding: 1.25rem;
		transition: transform 0.2s ease, border-color 0.2s ease;
	}

	.t-event-card:hover {
		border-color: rgba(245, 158, 11, 0.5);
		transform: translateY(-2px);
	}

	.t-event-card.highlight-event {
		border: 1.5px solid rgba(212, 175, 55, 0.6);
		background: linear-gradient(145deg, rgba(212, 175, 55, 0.1) 0%, rgba(0, 0, 0, 0.4) 100%);
	}

	.t-event-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 0.65rem;
	}

	.t-event-time-badge {
		font-size: 0.82rem;
		font-weight: 800;
		background: rgba(255, 255, 255, 0.1);
		color: #fff;
		border: 1px solid rgba(255, 255, 255, 0.2);
		padding: 0.2rem 0.6rem;
		border-radius: 4px;
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
	}

	.t-event-time-badge.gold-time {
		background: rgba(212, 175, 55, 0.25);
		color: var(--gold);
		border-color: var(--gold);
