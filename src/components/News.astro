	/* Bento Card Base Styling */
	.bento-card {
		background: rgba(255, 255, 255, 0.03);
		border: 1px solid rgba(255, 255, 255, 0.1);
		border-radius: 16px;
		position: relative;
		overflow: hidden;
		transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
		display: flex;
		flex-direction: column;
	}

	.bento-card:hover {
		transform: translateY(-3px);
		border-color: rgba(212, 175, 55, 0.4);
		box-shadow: 0 12px 30px rgba(0, 0, 0, 0.4);
	}

	.bento-card-featured {
		min-height: 460px;
		border: 1px solid rgba(212, 175, 55, 0.35);
		background: linear-gradient(145deg, rgba(0, 59, 43, 0.35) 0%, rgba(0, 0, 0, 0.45) 100%);
	}

	.bento-card-fall-cup {
		border: 1px solid rgba(226, 110, 23, 0.45);
		background: linear-gradient(145deg, rgba(46, 32, 10, 0.45) 0%, rgba(0, 30, 20, 0.45) 100%);
	}

	.bento-card-fall-cup:hover {
		border-color: rgba(245, 158, 11, 0.7);
		box-shadow: 0 12px 35px rgba(245, 158, 11, 0.25);
	}

	.featured-card-layout {
		display: flex;
		flex-direction: column;
		height: 100%;
	}

	.featured-img-preview {
		height: 220px;
		background-size: cover;
		background-position: center 20%;
		position: relative;
		cursor: pointer;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		padding: 1rem 1.25rem;
		border-bottom: 2px solid rgba(212, 175, 55, 0.3);
	}

	.fall-cup-preview {
		background-position: center 15%;
		border-bottom-color: rgba(226, 110, 23, 0.45);
	}

	.img-preview-overlay {
		position: absolute;
		inset: 0;
		background: linear-gradient(180deg, rgba(0, 0, 0, 0.3) 0%, rgba(0, 0, 0, 0.75) 100%);
		transition: background 0.3s ease;
	}

	.featured-img-preview:hover .img-preview-overlay {
		background: linear-gradient(180deg, rgba(0, 0, 0, 0.2) 0%, rgba(0, 0, 0, 0.6) 100%);
