	/* Details Split Grid (Pricing + Venue) */
	.t-details-split-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1.25rem;
		margin-bottom: 2rem;
	}

	.t-detail-box {
		background: rgba(255, 255, 255, 0.03);
		border: 1px solid rgba(255, 255, 255, 0.1);
		border-radius: 12px;
		padding: 1.25rem 1.5rem;
	}

	.t-detail-title {
		font-size: 1.1rem;
		color: var(--gold);
		font-family: var(--font-headings);
		font-weight: 800;
		margin: 0 0 0.85rem 0;
		display: flex;
		align-items: center;
		gap: 0.45rem;
	}

	.t-detail-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 0.45rem;
		font-size: 0.88rem;
		color: #ccc;
	}

	.t-detail-list strong {
		color: #fff;
	}

