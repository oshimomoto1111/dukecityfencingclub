---
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const currentYear = new Date().getFullYear();
---

<footer class="site-footer" id="contact">
	<div class="footer-container">
		<div class="footer-grid">
			
			<!-- Columna 1: Marca y Redes Sociales -->
			<div class="footer-col">
				<img src={`${base}logo.png`} alt="Duke City Fencing Club Logo" class="footer-logo" width="82" height="80" loading="lazy" />
				<p class="footer-about">
					Master the Art of Fencing. Elite competitive and recreational programs in the heart of Albuquerque, New Mexico.
				</p>
				<div class="social-icons">
					<a href="https://www.instagram.com/dukecityfencing/" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
						<i class="fab fa-instagram"></i>
					</a>
					<a href="https://www.facebook.com/p/Duke-City-Fencing-100035399540775/" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
						<i class="fab fa-facebook-f"></i>
					</a>
					<a href="https://www.youtube.com/@DukeCityFencing" target="_blank" rel="noopener noreferrer" aria-label="YouTube">
						<i class="fab fa-youtube"></i>
					</a>
					<a href="https://www.tiktok.com/@dukecityfencing" target="_blank" rel="noopener noreferrer" aria-label="TikTok">
						<i class="fab fa-tiktok"></i>
					</a>
				</div>
			</div>

			<!-- Columna 2: Información de Contacto + Google Maps -->
			<div class="footer-col">
				<h4>Contact & Location</h4>
				<ul class="contact-list">
					<li>
						<i class="fas fa-map-marker-alt"></i>
						<span>
							<strong>Menaul School Gymnasium</strong><br />
							301 Menaul Blvd NE<br />
							Albuquerque, NM 87107
						</span>
					</li>
					<li>
						<i class="fas fa-envelope"></i>
						<a href="mailto:info@dukecityfencing.net" class="footer-mail">info@dukecityfencing.net</a>
					</li>
				</ul>
				
				<!-- Google Maps embebido -->
				<div class="map-embed-wrapper">
					<iframe 
						src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3264.4449767664687!2d-106.6346!3d35.1075!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x87227494e808266d%3A0x6b44a30e8c05763!2s301%20Menaul%20Blvd%20NE%2C%20Albuquerque%2C%20NM%2087107!5e0!3m2!1sen!2sus!4v1700000000000!5m2!1sen!2sus" 
						width="100%" 
						height="160" 
						style="border:0;" 
						allowfullscreen="" 
						loading="lazy" 
						referrerpolicy="no-referrer-when-downgrade"
						title="Duke City Fencing Club Google Map Location">
					</iframe>
				</div>
			</div>

			<!-- Columna 3: Mapa del Campus (Croquis Exclusivo) -->
			<div class="footer-col">
				<h4>Find Us On Campus</h4>
				<div class="campus-map-wrapper">
					<img src={`${base}mapa-menaul.png`} alt="Campus Map to Duke City Fencing Club Gym" class="campus-map-img" loading="lazy" />
				</div>
				<p class="map-hint">
					*Use the Google map to arrive at 301 Menaul Blvd NE, then follow the campus map directions to reach the Gym.
				</p>
			</div>

		</div>

		<div class="footer-bottom">
			<p>&copy; {currentYear} Duke City Fencing Club. All rights reserved. | Website designed by Alqimia Creativa.</p>
		</div>
	</div>
</footer>

<style>
	.site-footer {
		background-color: var(--text-dark);
		color: var(--text-light);
		padding: var(--section-padding) 1.5rem 2rem;
		border-top: 5px solid var(--primary-green);
	}

	.footer-container {
		max-width: 1240px;
		margin: 0 auto;
	}

	.footer-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		gap: 3.5rem;
	}

	.footer-col h4 {
		color: var(--bg-cream);
		font-size: 1.25rem;
		margin-bottom: 1.5rem;
		border-bottom: 2px solid var(--accent-red);
		display: inline-block;
		padding-bottom: 0.35rem;
	}

	.footer-logo {
		max-height: 75px;
		width: auto;
		margin-bottom: 1.5rem;
	}

	.footer-about {
		opacity: 0.85;
		margin-bottom: 1.75rem;
		font-size: 0.95rem;
		line-height: 1.6;
	}

	.social-icons {
		display: flex;
		gap: 1rem;
	}

	.social-icons a {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 42px;
		height: 42px;
		background-color: rgba(255, 255, 255, 0.08);
		color: var(--text-light);
		border-radius: 50%;
		font-size: 1.15rem;
		transition: background-color 0.3s, transform 0.2s, color 0.3s;
		border: 1px solid rgba(255, 255, 255, 0.12);
	}

	.social-icons a:hover {
		background-color: var(--accent-red);
		color: #fff;
		transform: translateY(-3px);
	}

	.contact-list {
		list-style: none;
		margin-bottom: 1.5rem;
	}

	.contact-list li {
		display: flex;
		align-items: flex-start;
		gap: 1rem;
		margin-bottom: 1.2rem;
		opacity: 0.9;
		font-size: 0.95rem;
		line-height: 1.5;
	}

	.contact-list i {
		color: var(--accent-red);
		font-size: 1.2rem;
		margin-top: 0.2rem;
	}

	.footer-mail {
		color: var(--bg-cream);
		transition: color 0.3s;
	}

	.footer-mail:hover {
		color: var(--accent-red);
		text-decoration: underline;
	}

	.map-embed-wrapper {
		width: 100%;
		border-radius: var(--border-radius);
		overflow: hidden;
		border: 2px solid rgba(255, 255, 255, 0.1);
	}

	.campus-map-wrapper {
		width: 100%;
		border-radius: var(--border-radius);
		overflow: hidden;
		border: 1px solid rgba(255, 255, 255, 0.15);
		box-shadow: 0 6px 15px rgba(0, 0, 0, 0.35);
	}

	.campus-map-img {
		width: 100%;
		height: auto;
		display: block;
	}

	.map-hint {
		font-size: 0.85rem;
		opacity: 0.8;
		margin-top: 1rem;
		line-height: 1.5;
	}

	.footer-bottom {
		text-align: center;
		margin-top: 4.5rem;
		padding-top: 2rem;
		border-top: 1px solid rgba(255, 255, 255, 0.1);
		opacity: 0.65;
		font-size: 0.85rem;
	}
</style>
