---
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;

const coaches = [
	{ name: "Andy", role: "Adult Fencing Coach", img: `${base}andy.jpg` },
	{ name: "Bella", role: "Fencing Coach", img: `${base}bella.jpg` },
	{ name: "Izaya", role: "Fencing Coach", img: `${base}izaya.jpg` },
	{ name: "Violet", role: "Fencing Coach", img: `${base}violet.jpg` },
];
---

<section class="authority" id="coaches">
	<div class="authority-container">
		<div class="coach-showcase">
			<div class="coach-img-container">
				<img src={`${base}courtney.jpg`} alt="Coach Courtney Hurley - Olympic Medalist" class="coach-img" width="380" height="475" loading="lazy" />
			</div>
			<div class="coach-text">
				<span class="coach-subtitle">Head Coach & Founder</span>
				<h2>Learn from an Olympic Medalist</h2>
				<p>
					Led by 3-time Olympian and London 2012 Bronze Medalist, Courtney Hurley. As a certified Fencing Maestra—the highest coaching distinction worldwide—Courtney brings over 20 years of elite competitive experience directly to Albuquerque.
				</p>
				<p>
					Whether you are stepping onto the strip for the first time or aiming for the national podium, you are learning directly from the very best in the sport.
				</p>
				<button class="btn-solid open-booking" type="button">Train with Courtney</button>
			</div>
		</div>

		<h3 class="team-section-title">Meet Our Coaching Staff</h3>
		<div class="team-grid">
			{coaches.map((coach) => (
				<div class="team-card">
					<img src={coach.img} alt={`Coach ${coach.name}`} class="team-avatar" width="120" height="120" loading="lazy" />
					<h4 class="team-name">{coach.name}</h4>
					<div class="team-role">{coach.role}</div>
				</div>
			))}
		</div>
	</div>
</section>

<style>
	.authority {
		background-color: var(--text-dark);
		color: var(--text-light);
		padding: var(--section-padding);
	}

	.authority-container {
		max-width: 1240px;
		margin: 0 auto;
	}

	.coach-showcase {
		display: grid;
		grid-template-columns: 42% 58%;
		align-items: center;
		gap: 4rem;
		margin-bottom: 5rem;
	}

	.coach-img-container {
		width: 100%;
		display: flex;
		justify-content: center;
	}

	.coach-img {
		width: 100%;
		max-width: 400px;
		height: auto;
		border-radius: var(--border-radius);
		box-shadow: 0 20px 50px rgba(0, 0, 0, 0.7);
		border: 1px solid rgba(255, 255, 255, 0.1);
	}

	.coach-subtitle {
		display: inline-block;
		color: var(--accent-red);
		font-weight: 800;
		font-size: 0.9rem;
		text-transform: uppercase;
		letter-spacing: 1.5px;
		margin-bottom: 0.5rem;
	}

	.coach-text h2 {
		font-size: 2.6rem;
		margin-bottom: 1.25rem;
		color: var(--bg-cream);
		line-height: 1.15;
	}

	.coach-text p {
		font-size: 1.1rem;
		opacity: 0.9;
		margin-bottom: 1.5rem;
		line-height: 1.7;
	}

	.btn-solid {
		display: inline-block;
		background-color: var(--accent-red);
		color: var(--text-light);
		padding: 0.9rem 2rem;
		border-radius: var(--border-radius);
		font-weight: 700;
		font-family: var(--font-headings);
		text-transform: uppercase;
		font-size: 0.95rem;
		border: none;
		cursor: pointer;
		letter-spacing: 1px;
		transition: background 0.3s, transform 0.2s;
	}

	.btn-solid:hover {
		background-color: var(--accent-red-hover);
		transform: translateY(-2px);
	}

	.team-section-title {
		text-align: center;
		font-size: 2.2rem;
		margin-bottom: 3.5rem;
		color: var(--bg-cream);
		border-top: 1px solid rgba(255, 255, 255, 0.12);
		padding-top: 4.5rem;
	}

	.team-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
		gap: 2rem;
	}

	.team-card {
		background-color: rgba(255, 255, 255, 0.04);
		border-radius: var(--border-radius);
		padding: 2.25rem 1.5rem;
		text-align: center;
		border: 1px solid rgba(255, 255, 255, 0.08);
		transition: transform 0.3s ease, background-color 0.3s ease;
	}

	.team-card:hover {
		transform: translateY(-5px);
		background-color: rgba(255, 255, 255, 0.07);
	}

	.team-avatar {
		width: 120px;
		height: 120px;
		border-radius: 50%;
		object-fit: cover;
		margin: 0 auto 1.5rem;
		border: 3px solid var(--accent-red);
		box-shadow: 0 6px 15px rgba(0, 0, 0, 0.4);
	}

	.team-name {
		font-size: 1.45rem;
		color: var(--bg-cream);
		margin-bottom: 0.4rem;
	}

	.team-role {
		font-size: 0.85rem;
		color: var(--gold);
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 1px;
	}

	@media (max-width: 900px) {
		.coach-showcase {
			grid-template-columns: 1fr;
			gap: 2.5rem;
			text-align: center;
		}
		.coach-img {
			max-width: 320px;
		}
		.coach-text h2 {
			font-size: 2.1rem;
		}
	}
</style>
