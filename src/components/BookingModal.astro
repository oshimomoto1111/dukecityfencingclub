---
// Dynamic Booking Modal component connected to Gymdesk registration
---

<div id="bookingModal" class="modal-overlay" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
	<div class="modal-content">
		<button class="close-modal" id="closeModalBtn" aria-label="Close booking window">&times;</button>
		
		<div class="modal-header">
			<span class="modal-kicker"><i class="fas fa-shield-alt"></i> Official Club Registration</span>
			<h2 id="modalTitle">Book Your Class</h2>
			<p id="modalSubtitle">Review session details and proceed directly to secure Gymdesk registration.</p>
		</div>

		<!-- Dynamic Program Details Card -->
		<div class="booking-slot" id="bookingSlotCard">
			<div class="slot-badge" id="modalBadge">Featured</div>
			<h4 id="modalProgramTitle">Youth Fencing Class (Ages 6–9)</h4>
			
			<!-- Price & Trial Highlight -->
			<div class="slot-pricing-row">
				<span class="slot-price" id="modalPrice">$140 /month + tax</span>
				<span class="slot-trial-badge" id="modalTrial">★ $10 Trial Available</span>
			</div>

			<!-- Dynamic Schedules List -->
			<div class="slot-schedules-wrap" id="modalSchedulesContainer">
				<div class="schedule-item">
					<i class="far fa-clock"></i> <strong>Saturdays:</strong> 10:30 AM – 11:30 AM
				</div>
			</div>
		</div>

		<!-- Dynamic Features Checkmarks -->
		<div class="booking-features" id="modalFeaturesList">
			<div class="feature-item"><i class="fas fa-check-circle"></i> Gear provided for beginners</div>
			<div class="feature-item"><i class="fas fa-check-circle"></i> Olympic-level coaching</div>
			<div class="feature-item"><i class="fas fa-check-circle"></i> Fun, safe, and engaging environment</div>
		</div>

		<!-- Direct Gymdesk Link Button -->
		<a 
			href="https://duke-city-fencing-club.gymdesk.com/book" 
			target="_blank" 
			rel="noopener noreferrer" 
			class="btn-pay"
			id="modalPayBtn"
		>
			<span id="modalBtnText">Continue to Gymdesk Registration</span> <i class="fas fa-arrow-right"></i>
		</a>

		<p class="modal-secure-notice">
			<i class="fas fa-lock"></i> Secure registration, waiver, and payment powered by Gymdesk
		</p>
	</div>
</div>

<style>
	.modal-overlay {
		position: fixed;
		inset: 0;
		background: rgba(0, 0, 0, 0.82);
		backdrop-filter: blur(8px);
		display: none;
		justify-content: center;
		align-items: center;
		z-index: 10000;
		padding: 1.5rem;
	}

	.modal-overlay.active {
		display: flex;
	}

	.modal-content {
		background-color: var(--bg-cream);
		color: var(--text-dark);
		border-radius: 18px;
		width: 100%;
		max-width: 540px;
		padding: 2.5rem 2.25rem 2rem;
		position: relative;
		box-shadow: 0 25px 70px rgba(0, 0, 0, 0.6);
		animation: modalFadeIn 0.3s cubic-bezier(0.16, 1, 0.3, 1);
		border: 2px solid var(--primary-green);
		max-height: 92vh;
		overflow-y: auto;
	}

	@keyframes modalFadeIn {
		from {
			opacity: 0;
			transform: scale(0.92) translateY(20px);
		}
		to {
			opacity: 1;
			transform: scale(1) translateY(0);
		}
	}

	.close-modal {
		position: absolute;
		top: 1rem;
		right: 1.25rem;
		font-size: 2.2rem;
		background: none;
		border: none;
		color: var(--text-dark);
		cursor: pointer;
		line-height: 1;
		opacity: 0.6;
		transition: opacity 0.2s, color 0.2s;
	}

	.close-modal:hover {
		opacity: 1;
		color: var(--accent-red);
	}

	.modal-header {
		text-align: center;
		margin-bottom: 1.5rem;
	}

	.modal-kicker {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font-size: 0.75rem;
		font-weight: 800;
		text-transform: uppercase;
		letter-spacing: 1px;
		color: var(--primary-green);
		background: rgba(0, 59, 43, 0.08);
		padding: 0.25rem 0.75rem;
		border-radius: 50px;
		margin-bottom: 0.5rem;
	}

	.modal-header h2 {
		font-size: 1.85rem;
		color: var(--primary-green);
		margin-bottom: 0.35rem;
		font-family: var(--font-headings);
		font-weight: 800;
	}

	.modal-header p {
		font-size: 0.92rem;
		opacity: 0.85;
		line-height: 1.4;
		margin: 0;
	}

	.booking-slot {
		background: #fff;
		border: 2px solid var(--primary-green);
		padding: 1.5rem;
		border-radius: 12px;
		margin-bottom: 1.25rem;
		position: relative;
		box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
	}

	.slot-badge {
		position: absolute;
		top: -12px;
		right: 15px;
		background-color: var(--accent-red);
		color: #fff;
		font-size: 0.75rem;
		font-weight: 800;
		text-transform: uppercase;
		padding: 0.25rem 0.75rem;
		border-radius: 50px;
		letter-spacing: 0.5px;
		box-shadow: 0 2px 8px rgba(226, 10, 23, 0.4);
	}

	.booking-slot h4 {
		font-size: 1.35rem;
		color: var(--primary-green);
		margin: 0 0 0.75rem 0;
		font-family: var(--font-headings);
		font-weight: 800;
	}

	.slot-pricing-row {
		display: flex;
		justify-content: space-between;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.5rem;
		padding-bottom: 0.85rem;
		margin-bottom: 0.85rem;
		border-bottom: 1px dashed rgba(0, 0, 0, 0.15);
	}

	.slot-price {
		font-size: 1.15rem;
		color: var(--primary-green);
		font-weight: 800;
	}

	.slot-trial-badge {
		background: #fff4e5;
		color: #b75e00;
		border: 1px solid #ffcc80;
		font-size: 0.8rem;
		font-weight: 700;
		padding: 0.25rem 0.65rem;
		border-radius: 6px;
	}

	.slot-schedules-wrap {
		display: flex;
		flex-direction: column;
		gap: 0.45rem;
	}

	.schedule-item {
		font-size: 0.88rem;
		color: #444;
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.schedule-item i {
		color: var(--accent-red);
		font-size: 0.85rem;
	}

	.booking-features {
		display: flex;
		flex-direction: column;
		gap: 0.55rem;
		margin-bottom: 1.5rem;
		padding: 0 0.25rem;
	}

	.feature-item {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		font-size: 0.88rem;
		font-weight: 600;
		color: var(--text-dark);
	}

	.feature-item i {
		color: var(--primary-green);
		font-size: 0.95rem;
		flex-shrink: 0;
	}

	.btn-pay {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.75rem;
		width: 100%;
		background-color: var(--accent-red);
		color: var(--text-light);
		padding: 0.95rem 1.5rem;
		border-radius: var(--border-radius);
		font-weight: 800;
		font-family: var(--font-headings);
		text-transform: uppercase;
		font-size: 0.95rem;
		border: none;
		cursor: pointer;
		text-align: center;
		text-decoration: none;
		transition: background 0.3s, transform 0.2s, box-shadow 0.3s;
		box-shadow: 0 4px 15px rgba(226, 10, 23, 0.4);
		letter-spacing: 1px;
	}

	.btn-pay:hover {
		background-color: var(--accent-red-hover);
		transform: translateY(-2px);
		box-shadow: 0 6px 20px rgba(226, 10, 23, 0.55);
	}

	.modal-secure-notice {
		text-align: center;
		font-size: 0.78rem;
		color: #777;
		margin: 0.85rem 0 0 0;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.4rem;
	}

	.modal-secure-notice i {
		color: var(--primary-green);
	}
</style>

<script>
	const modal = document.getElementById('bookingModal');
	const openButtons = document.querySelectorAll('.open-booking');
	const closeBtn = document.getElementById('closeModalBtn');

	// DOM Elements to update dynamically
	const modalTitle = document.getElementById('modalTitle');
	const modalBadge = document.getElementById('modalBadge');
	const modalProgramTitle = document.getElementById('modalProgramTitle');
	const modalPrice = document.getElementById('modalPrice');
	const modalTrial = document.getElementById('modalTrial');
	const modalSchedulesContainer = document.getElementById('modalSchedulesContainer');
	const modalFeaturesList = document.getElementById('modalFeaturesList');
	const modalPayBtn = document.getElementById('modalPayBtn') as HTMLAnchorElement | null;
	const modalBtnText = document.getElementById('modalBtnText');

	// Default fallback data for generic header/hero buttons
	const defaultData = {
		title: "Duke City Fencing Trial Class",
		badge: "All Programs",
		price: "From $10 Trial Session",
		trial: "★ Gear Provided Included",
		schedules: [
			{ days: "Youth Class", time: "Saturdays 10:30 AM – 11:30 AM" },
			{ days: "Competitive Epee", time: "Tue & Thu 5:00 PM – 7:30 PM" },
			{ days: "Adult Recreation", time: "Mondays 7:00 PM – 8:00 PM" }
		],
		features: [
			"Gear fully provided for all beginner and trial fencers",
			"Coached directly by Olympic Medalist & certified fencing masters",
			"Safe, engaging, and structured athletic training"
		],
		link: "https://duke-city-fencing-club.gymdesk.com/book"
	};

	openButtons.forEach((button) => {
		button.addEventListener('click', (e) => {
			e.preventDefault();

			const title = button.getAttribute('data-title');
			const badge = button.getAttribute('data-badge') || button.getAttribute('data-level');
			const price = button.getAttribute('data-price');
			const trial = button.getAttribute('data-trial');
			const schedulesRaw = button.getAttribute('data-schedules');
			const featuresRaw = button.getAttribute('data-features');
			const link = button.getAttribute('data-link') || "https://duke-city-fencing-club.gymdesk.com/book";

			if (title) {
				// Specific program card clicked
				if (modalTitle) modalTitle.textContent = "Book Your Class";
				if (modalProgramTitle) modalProgramTitle.textContent = title;
				if (modalBadge) modalBadge.textContent = badge || "Featured";
				if (modalPrice) modalPrice.textContent = price || "$140 /month";
				
				if (modalTrial) {
					if (trial && trial.trim()) {
						modalTrial.textContent = trial;
						modalTrial.style.display = "inline-block";
					} else {
						modalTrial.style.display = "none";
					}
				}

				// Populate schedules
				if (modalSchedulesContainer) {
					modalSchedulesContainer.innerHTML = "";
					try {
						const schedules = schedulesRaw ? JSON.parse(schedulesRaw) : [];
						if (schedules.length > 0) {
							schedules.forEach((sch: { days: string; time: string }) => {
								const div = document.createElement('div');
								div.className = 'schedule-item';
								div.innerHTML = `<i class="far fa-clock"></i> <strong>${sch.days}:</strong> ${sch.time}`;
								modalSchedulesContainer.appendChild(div);
							});
						}
					} catch (err) {
						console.error("Error parsing schedules", err);
					}
				}

				// Populate features
				if (modalFeaturesList) {
					modalFeaturesList.innerHTML = "";
					try {
						const features = featuresRaw ? JSON.parse(featuresRaw) : [];
						features.slice(0, 3).forEach((feat: string) => {
							const div = document.createElement('div');
							div.className = 'feature-item';
							div.innerHTML = `<i class="fas fa-check-circle"></i> <span>${feat}</span>`;
							modalFeaturesList.appendChild(div);
						});
					} catch (err) {
						console.error("Error parsing features", err);
					}
				}

				if (modalPayBtn) modalPayBtn.href = link;
				if (modalBtnText) modalBtnText.textContent = `Register for ${title.split('(')[0].trim()}`;

			} else {
				// Generic button (Header / Hero)
				if (modalTitle) modalTitle.textContent = "Book Your Session";
				if (modalProgramTitle) modalProgramTitle.textContent = defaultData.title;
				if (modalBadge) modalBadge.textContent = defaultData.badge;
				if (modalPrice) modalPrice.textContent = defaultData.price;
				if (modalTrial) {
					modalTrial.textContent = defaultData.trial;
					modalTrial.style.display = "inline-block";
				}

				if (modalSchedulesContainer) {
					modalSchedulesContainer.innerHTML = "";
					defaultData.schedules.forEach((sch) => {
						const div = document.createElement('div');
						div.className = 'schedule-item';
						div.innerHTML = `<i class="far fa-clock"></i> <strong>${sch.days}:</strong> ${sch.time}`;
						modalSchedulesContainer.appendChild(div);
					});
				}

				if (modalFeaturesList) {
					modalFeaturesList.innerHTML = "";
					defaultData.features.forEach((feat) => {
						const div = document.createElement('div');
						div.className = 'feature-item';
						div.innerHTML = `<i class="fas fa-check-circle"></i> <span>${feat}</span>`;
						modalFeaturesList.appendChild(div);
					});
				}

				if (modalPayBtn) modalPayBtn.href = defaultData.link;
				if (modalBtnText) modalBtnText.textContent = "Continue to Gymdesk Registration";
			}

			modal?.classList.add('active');
			modal?.setAttribute('aria-hidden', 'false');
		});
	});

	closeBtn?.addEventListener('click', () => {
		modal?.classList.remove('active');
		modal?.setAttribute('aria-hidden', 'true');
	});

	window.addEventListener('click', (e) => {
		if (e.target === modal) {
			modal?.classList.remove('active');
			modal?.setAttribute('aria-hidden', 'true');
		}
	});

	window.addEventListener('keydown', (e) => {
		if (e.key === 'Escape' && modal?.classList.contains('active')) {
			modal.classList.remove('active');
			modal.setAttribute('aria-hidden', 'true');
		}
	});
</script>
